    local pct = math.clamp(INTENSITY / 10, 0, 1)
    
    local grad = Instance.new("UIGradient")
    grad.Rotation = 45 
    grad.Enabled = false 
    grad.Parent = ui
    
    local prg = 0 
    local currentOffset = Vector2.new(0, 0)
    
    rs.RenderStepped:Connect(function(dt)
    	if not ui.Visible then return end
    
    	local h = false
    	local pos = ui.AbsolutePosition
    	local size = ui.AbsoluteSize
    
    	-- Pixel-perfect boundaries using PlayerMouse coordinates
    	if m.X >= pos.X and m.X <= (pos.X + size.X) and m.Y >= pos.Y and m.Y <= (pos.Y + size.Y) then
    		h = true
    	end
    
    	local wasIdle = (prg == 0)
    	prg = math.clamp(prg + (dt * FADE_SPEED * (h and 1 or -1)), 0, 1)
    
    	if wasIdle and prg == 0 then
    		if grad.Enabled then grad.Enabled = false end
    		return
    	end
    
    	if wasIdle and prg > 0 then
    		grad.Enabled = true
    	end
    
    	-- LIVE READ: Reads the base color live
    	local oc = ui.BackgroundColor3
    	local hc = Color3.new(
    		math.clamp(oc.R + (1 - oc.R) * pct, 0, 1),
    		math.clamp(oc.G + (1 - oc.G) * pct, 0, 1),
    		math.clamp(oc.B + (1 - oc.B) * pct, 0, 1)
    	)
    
    	-- 1. Calculate mouse position relative to the element (using pixel-perfect coordinates)
    	local scaleX = size.X > 0 and math.clamp((m.X - pos.X) / size.X, 0, 1) or 0.5
    	local scaleY = size.Y > 0 and math.clamp((m.Y - pos.Y) / size.Y, 0, 1) or 0.5
    
    	-- 2. Shift the center...
    	local targetOffset = Vector2.new(scaleX - 0.5, scaleY - 0.5)
    
    	-- 3. Apply drag/lag...
    	currentOffset = currentOffset:Lerp(targetOffset, math.clamp(dt * LAG_SPEED, 0, 1))
    	grad.Offset = currentOffset
    
    	-- 4. Blend the gradient's center color dynamically
    	local currentMidColor = oc:Lerp(hc, prg)
    
    	-- 5. Calculate expanded spread colors
    	local spreadColor = oc:Lerp(currentMidColor, SPREAD_SOFTNESS)
    
    	-- 6. Apply the sequence
    	grad.Color = ColorSequence.new({
    		ColorSequenceKeypoint.new(0, oc),                       
    		ColorSequenceKeypoint.new(0.2, spreadColor),            
    		ColorSequenceKeypoint.new(0.5, currentMidColor),        
    		ColorSequenceKeypoint.new(0.8, spreadColor),            
    		ColorSequenceKeypoint.new(1, oc)                        
    	})
    end)
end)

task.spawn(function() -- Deferred Script Context Connection Mode
    local script = { Parent = ui_instances.AutoFarmStorageToggle_2840, Name = "Function" }
    local TweenService = game:GetService("TweenService")
    local RunService = game:GetService("RunService")
    local Players = game:GetService("Players")
    
    local player = Players.LocalPlayer
    
    local button = script.Parent
    local ind = button.Indicator
    
    local red = Color3.fromRGB(255, 0, 0)
    local green = Color3.fromRGB(0, 255, 0)
    
    local active = false
    local healing = false
    
    -- Used to invalidate old procedures when toggled off
    local procedureId = 0
    
    -- Original player location
    local originalCFrame = nil
    
    -- Connections
    local cameraConnection = nil
    local healthConnection = nil
    
    --========================================================
    -- BUTTON ANIMATION
    --========================================================
    
    local originalSize = button.Size
    
    local tweenInfoUp = TweenInfo.new(
    	0.08,
    	Enum.EasingStyle.Quad,
    	Enum.EasingDirection.Out
    )
    
    local tweenInfoDown = TweenInfo.new(
    	0.08,
    	Enum.EasingStyle.Quad,
    	Enum.EasingDirection.In
    )
    
    local biggerSize = UDim2.new(
    	originalSize.X.Scale,
    	originalSize.X.Offset + 6,
    	originalSize.Y.Scale,
    	originalSize.Y.Offset + 6
    )
    
    local currentTween = nil
    
    
    --========================================================
    -- CHARACTER
    --========================================================
    
    local function getCharacter()
    	local character = player.Character
    
    	if not character then
    		return nil, nil, nil
    	end
    
    	local humanoid = character:FindFirstChildOfClass("Humanoid")
    	local root = character:FindFirstChild("HumanoidRootPart")
    
    	if not humanoid or not root then
    		return character, humanoid, root
    	end
    
    	return character, humanoid, root
    end
    
    
    local function teleportTo(cframe)
    	local _, _, root = getCharacter()
    
    	if not root then
    		return false
    	end
    
    	root.CFrame = cframe
    
    	return true
    end
    
    
    local function isProcedureValid(id)
    	return active and procedureId == id
    end
    
    
    --========================================================
    -- CAMERA
    --========================================================
    
    local function forceCameraLookAt(part)
    	if cameraConnection then
    		cameraConnection:Disconnect()
    		cameraConnection = nil
    	end
    
    	if not part or not part.Parent then
    		return
    	end
    
    	local camera = workspace.CurrentCamera
    
    	cameraConnection = RunService.RenderStepped:Connect(function()
    		if not active or not part or not part.Parent then
    			return
    		end
    
    		camera.CameraType = Enum.CameraType.Scriptable
    
    		camera.CFrame = CFrame.lookAt(
    			camera.CFrame.Position,
    			part.Position
    		)
    	end)
    
    	camera.CameraType = Enum.CameraType.Scriptable
    
    	camera.CFrame = CFrame.lookAt(
    		camera.CFrame.Position,
    		part.Position
    	)
    end
    
    
    local function restoreCamera()
    	if cameraConnection then
    		cameraConnection:Disconnect()
    		cameraConnection = nil
    	end
    
    	local camera = workspace.CurrentCamera
    
    	camera.CameraType = Enum.CameraType.Custom
    
    	local _, humanoid = getCharacter()
    
    	if humanoid then
    		camera.CameraSubject = humanoid
    	end
    end
    
    
    --========================================================
    -- HEALING
    --========================================================
    
    local function startHealing(id)
    	if healing then
    		return
    	end
    
    	healing = true
    
    	local _, humanoid, root = getCharacter()
    
    	if not humanoid or not root then
    		healing = false
    		return
    	end
    
    	-- Stop movement immediately
    	root.Anchored = true
    
    	-- Move to healing location
    	root.CFrame = CFrame.new(
    		-50,
    		-15,
    		-300
    	)
    
    	-- Healing monitor
    	task.spawn(function()
    
    		while active and procedureId == id and healing do
    
    			local _, currentHumanoid, currentRoot = getCharacter()
    
    			if not currentHumanoid or not currentRoot then
    				break
    			end
    
    			if currentHumanoid.Health >= 80 then
    				break
    			end
    
    			task.wait(0.05)
    		end
    
    		if not active or procedureId ~= id then
    			return
    		end
    
    		local _, currentHumanoid, currentRoot = getCharacter()
    
    		if currentRoot then
    			currentRoot.Anchored = false
    		end
    
    		healing = false
    	end)
    end
    
    
    --========================================================
    -- HEALTH MONITOR
    --========================================================
    
    local function setupHealthMonitor(id)
    	if healthConnection then
    		healthConnection:Disconnect()
    		healthConnection = nil
    	end
    
    	local _, humanoid = getCharacter()
    
    	if not humanoid then
    		return
    	end
    
    	healthConnection = humanoid.HealthChanged:Connect(function(health)
    
    		if not active or procedureId ~= id then
    			return
    		end
    
    		if health < 80 and not healing then
    			startHealing(id)
    		end
    	end)
    end
    
    
    --========================================================
    -- GENERAL ABORT CHECK
    --========================================================
    
    local function shouldAbort(id)
    
    	if not isProcedureValid(id) then
    		return true
    	end
    
    	local _, humanoid = getCharacter()
    
    	if not humanoid then
    		return true
    	end
    
    	if humanoid.Health < 80 then
    
    		if not healing then
    			startHealing(id)
    		end
    
    		return true
    	end
    
    	return false
    end
    
    
    --========================================================
    -- WAIT WITH HEALTH CHECK
    --========================================================
    
    local function smartWait(seconds, id)
    
    	local elapsed = 0
    
    	while elapsed < seconds do
    
    		if shouldAbort(id) then
    			return false
    		end
    
    		task.wait(0.05)
    
    		elapsed += 0.05
    	end
    
    	return true
    end
    
    
    --========================================================
    -- NEARBY MOB CHECK
    --========================================================
    
    local function hasNearbyMob(storageModel)
    
    	local mobsFolder = workspace:FindFirstChild("Mobs")
    
    	if not mobsFolder then
    		return false
    	end
    
    	local storagePosition
    
    	if storageModel:IsA("Model") then
    		storagePosition = storageModel:GetPivot().Position
    
    	elseif storageModel:IsA("BasePart") then
    		storagePosition = storageModel.Position
    
    	else
    		return false
    	end
    
    	for _, mob in ipairs(mobsFolder:GetChildren()) do
    
    		if mob:IsA("Model") then
    
    			local mobRoot =
    				mob:FindFirstChild("HumanoidRootPart")
    				or mob.PrimaryPart
    
    			if mobRoot then
    
    				local distance =
    					(mobRoot.Position - storagePosition).Magnitude
    
    				if distance <= 35 then
    					return true
    				end
    			end
    		end
    	end
    
    	return false
    end
    
    
    --========================================================
    -- STORAGE VALIDATION
    --========================================================
    
    local function isValidStorage(child)
    
    	if not child:IsA("Model") then
    		return false
    	end
    
    	-- Owner attribute existing at all = invalid
    	if child:GetAttribute("Owner") ~= nil then
    		return false
    	end
    
    	-- Locked attribute existing at all = invalid
    	if child:GetAttribute("Locked") ~= nil then
    		return false
    	end
    
    	-- Open == true = invalid
    	if child:GetAttribute("Open") == true then
    		return false
    	end
    
    	-- Mob within 35 studs = invalid
    	if hasNearbyMob(child) then
    		return false
    	end
    
    	return true
    end
    
    
    local function getRandomValidStorage(id)
    
    	local storages = workspace:FindFirstChild("Storages")
    
    	if not storages then
    		return nil
    	end
    
    	local candidates = {}
    
    	for _, child in ipairs(storages:GetChildren()) do
    
    		if not isProcedureValid(id) then
    			return nil
    		end
    
    		if isValidStorage(child) then
    			table.insert(candidates, child)
    		end
    	end
    
    	if #candidates == 0 then
    		return nil
    	end
    
    	return candidates[
    	math.random(1, #candidates)
    	]
    end
    
    
    --========================================================
    -- FIND PROXIMITY PROMPT
    --========================================================
    
    local function findPrompt(container)
    
    	if not container then
    		return nil
    	end
    
    	return container:FindFirstChildWhichIsA(
    		"ProximityPrompt",
    		true
    	)
    end
    
    
    --========================================================
    -- WAIT FOR STORAGE RESULT
    --========================================================
    
    local function waitForStorageResult(storageModel, id)
    
    	local contents =
    		storageModel:FindFirstChild("Contents")
    
    	-- Mobs always wins immediately
    	if contents and contents:FindFirstChild("Mobs") then
    		return "MOBS"
    	end
    
    	local result = nil
    
    	local connections = {}
    
    	local function checkStorage()
    
    		if not storageModel.Parent then
    			result = "INVALID"
    			return
    		end
    
    		local currentContents =
    			storageModel:FindFirstChild("Contents")
    
    		if not currentContents then
    			return
    		end
    
    		-- MOBS ALWAYS HAS PRIORITY
    		if currentContents:FindFirstChild("Mobs") then
    			result = "MOBS"
    			return
    		end
    
    		-- Loot is ready
    		if currentContents:FindFirstChild("Loot") then
    			result = "LOOT"
    			return
    		end
    	end
    
    
    	table.insert(
    		connections,
    		storageModel.DescendantAdded:Connect(
    			checkStorage
    		)
    	)
    
    	table.insert(
    		connections,
    		storageModel.DescendantRemoving:Connect(
    			checkStorage
    		)
    	)
    
    	-- Check immediately
    	checkStorage()
    
    
    	while not result do
    
    		if shouldAbort(id) then
    
    			for _, connection in ipairs(connections) do
    				connection:Disconnect()
    			end
    
    			return "ABORT"
    		end
    
    		local currentContents =
    			storageModel:FindFirstChild("Contents")
    
    		if currentContents then
    
    			-- Mobs gets checked FIRST
    			if currentContents:FindFirstChild("Mobs") then
    				result = "MOBS"
    				break
    			end
    
    			if currentContents:FindFirstChild("Loot") then
    				result = "LOOT"
    				break
    			end
    		end
    
    		task.wait(0.03)
    	end
    
    
    	for _, connection in ipairs(connections) do
    		connection:Disconnect()
    	end
    
    	return result
    end
    
    
    --========================================================
    -- LOOT
    --========================================================
    
    local function lootContents(storageModel, id)
    
    	local contents =
    		storageModel:FindFirstChild("Contents")
    
    	if not contents then
    		return true
    	end
    
    	-- Mobs ALWAYS wins
    	if contents:FindFirstChild("Mobs") then
    		return false
    	end
    
    	local loot =
    		contents:FindFirstChild("Loot")
    
    
    	-- Loot doesn't exist yet
    	if not loot then
    
    		if not smartWait(1, id) then
    			return false
    		end
    
    		contents =
    			storageModel:FindFirstChild("Contents")
    
    		if not contents then
    			return true
    		end
    
    		-- Check Mobs again FIRST
    		if contents:FindFirstChild("Mobs") then
    			return false
    		end
    
    		loot =
    			contents:FindFirstChild("Loot")
    
    		if not loot then
    			return true
    		end
    	end
    
    
    	local lootChildren =
    		loot:GetChildren()
    
    
    	for _, lootItem in ipairs(lootChildren) do
    
    		if shouldAbort(id) then
    			return false
    		end
    
    		-- Mobs could appear while looting
    		if contents:FindFirstChild("Mobs") then
    			return false
    		end
    
    		local _, humanoid, root =
    			getCharacter()
    
    		if not humanoid or not root then
    			return false
    		end
    
    		local lootPart
    
    
    		if lootItem:IsA("BasePart") then
    
    			lootPart = lootItem
    
    		elseif lootItem:IsA("Model") then
    
    			lootPart =
    				lootItem.PrimaryPart
    				or lootItem:FindFirstChildWhichIsA(
    					"BasePart",
    					true
    				)
    		end
    
    
    		if lootPart then
    
    			-- Teleport to loot
    			root.CFrame =
    				lootPart.CFrame
    
    			-- Force camera
    			forceCameraLookAt(
    				lootPart
    			)
    
    			-- Find prompt
    			local prompt =
    				findPrompt(lootItem)
    
    			if prompt then
    
    				if typeof(
    					fireproximityprompt
    					) == "function" then
    
    					fireproximityprompt(
    						prompt
    					)
    				end
    			end
    
    			-- Tiny delay so the game can process it
    			if not smartWait(
    				0.05,
    				id
    				) then
    
    				return false
    			end
    		end
    	end
    
    	return true
    end
    
    
    --========================================================
    -- PROCESS ONE STORAGE
    --========================================================
    
    local function processStorage(
    	storageModel,
    	id
    )
    
    	if shouldAbort(id) then
    		return false
    	end
    
    	local door =
    		storageModel:FindFirstChild("Door")
    
    	if not door then
    		return false
    	end
    
    	local cube =
    		door:FindFirstChild("Cube.001")
    
    	local handle =
    		door:FindFirstChild("Handle")
    
    
    	if not cube or not cube:IsA("BasePart") then
    		return false
    	end
    
    	if not handle or not handle:IsA("BasePart") then
    		return false
    	end
    
    
    	--======================================================
    	-- TELEPORT 5 STUDS BACK
    	--======================================================
    
    	-- +Z on the part's local axis.
    	-- Change 5 to -5 if you want the opposite direction.
    
    	local startingCFrame =
    		cube.CFrame
    		* CFrame.new(0, 0, 5)
    
    
    	if not teleportTo(
    		startingCFrame
    		) then
    
    		return false
    	end
    
    
    	--======================================================
    	-- WAIT 2 SECONDS
    	--======================================================
    
    	if not smartWait(
    		2,
    		id
    		) then
    
    		return false
    	end
    
    
    	--======================================================
    	-- TWEEN TO HANDLE
    	--======================================================
    
    	local _, humanoid, root =
    		getCharacter()
    
    	if not humanoid or not root then
    		return false
    	end
    
    
    	local tween =
    		TweenService:Create(
    			root,
    
    			TweenInfo.new(
    				1,
    				Enum.EasingStyle.Linear,
    				Enum.EasingDirection.InOut
    			),
    
    			{
    				CFrame = handle.CFrame
    			}
    		)
    
    
    	tween:Play()
    
    
    	while tween.PlaybackState ==
    		Enum.PlaybackState.Playing do
    
    		-- Health is checked DURING tween
    		if shouldAbort(id) then
    
    			tween:Cancel()
    
    			return false
    		end
    
    		task.wait(0.03)
    	end
    
    
    	if shouldAbort(id) then
    		return false
    	end
    
    
    	--======================================================
    	-- FORCE CAMERA TO HANDLE
    	--======================================================
    
    	forceCameraLookAt(
    		handle
    	)
    
    
    	--======================================================
    	-- FIRE DOOR PROMPT
    	--======================================================
    
    	local prompt =
    		findPrompt(handle)
    
    	if prompt then
    
    		if typeof(
    			fireproximityprompt
    			) == "function" then
    
    			fireproximityprompt(
    				prompt
    			)
    		end
    	end
    
    
    	--======================================================
    	-- WAIT FOR RESULT
    	--======================================================
    
    	local result =
    		waitForStorageResult(
    			storageModel,
    			id
    		)
    
    
    	if result == "ABORT" then
    		return false
    	end
    
    
    	--======================================================
    	-- MOBS = IMMEDIATELY ABORT
    	--======================================================
    
    	if result == "MOBS" then
    
    		-- Do NOT touch Loot.
    		-- Do NOT wait.
    		-- Immediately return so the main loop
    		-- picks another storage.
    
    		return false
    	end
    
    
    	--======================================================
    	-- LOOT
    	--======================================================
    
    	if result == "LOOT" then
    
    		return lootContents(
    			storageModel,
    			id
    		)
    	end
    
    
    	return true
    end
    
    
    --========================================================
    -- CLEANUP
    --========================================================
    
    local function cleanup(
    	restorePosition
    )
    
    	local _, _, root =
    		getCharacter()
    
    	if root then
    		root.Anchored = false
    	end
    
    	healing = false
    
    	restoreCamera()
    
    
    	if restorePosition
    		and originalCFrame then
    
    		local _, _, currentRoot =
    			getCharacter()
    
    		if currentRoot then
    
    			currentRoot.CFrame =
    				originalCFrame
    		end
    	end
    
    
    	if healthConnection then
    
    		healthConnection:Disconnect()
    
    		healthConnection = nil
    	end
    end
    
    
    --========================================================
    -- MAIN PROCEDURE
    --========================================================
    
    local function runProcedure(id)
    
    	local char, humanoid, root =
    		getCharacter()
    
    	if not char
    		or not humanoid
    		or not root then
    
    		return
    	end
    
    
    	-- Save original position
    	originalCFrame =
    		root.CFrame
    
    
    	setupHealthMonitor(id)
    
    
    	while isProcedureValid(id) do
    
    		--==================================================
    		-- HEALTH
    		--==================================================
    
    		if humanoid.Health < 80
    			and not healing then
    
    			startHealing(id)
    		end
    
    
    		--==================================================
    		-- HEALING MODE
    		--==================================================
    
    		if healing then
    
    			while
    				isProcedureValid(id)
    				and healing do
    
    				task.wait(0.05)
    			end
    
    
    			if not isProcedureValid(id) then
    				return
    			end
    
    			-- Health reached 80+.
    			-- Immediately find another storage.
    		end
    
    
    		--==================================================
    		-- FIND RANDOM VALID STORAGE
    		--==================================================
    
    		local storage =
    			getRandomValidStorage(id)
    
    
    		if not storage then
    
    			-- Check again quickly
    			task.wait(0.05)
    
    			continue
    		end
    
    
    		--==================================================
    		-- PROCESS
    		--==================================================
    
    		processStorage(
    			storage,
    			id
    		)
    
    
    		if not isProcedureValid(id) then
    			return
    		end
    
    
    		-- Immediately search for another storage.
    		task.wait()
    	end
    end
    
    
    --========================================================
    -- TOGGLE
    --========================================================
    
    button.Activated:Connect(function()
    
    	-- Toggle
    	active = not active
    
    
    	if active then
    
    		ind.BackgroundColor3 = green
    
    	else
    
    		ind.BackgroundColor3 = red
    	end
    
    
    	--======================================================
    	-- BUTTON ANIMATION
    	--======================================================
    
    	if currentTween then
    		currentTween:Cancel()
    	end
    
    
    	button.Size = originalSize
    
    
    	currentTween =
    		TweenService:Create(
    			button,
    
    			tweenInfoUp,
    
    			{
    				Size = biggerSize
    			}
    		)
    
    
    	currentTween:Play()
    
    
    	currentTween.Completed:Connect(function()
    
    		if not button.Parent then
    			return
    		end
    
    
    		currentTween =
    			TweenService:Create(
    				button,
    
    				tweenInfoDown,
    
    				{
    					Size = originalSize
    				}
    			)
    
    
    		currentTween:Play()
    	end)
    
    
    	--======================================================
    	-- TURN ON
    	--======================================================
    
    	if active then
    
    		-- Invalidate any old procedure
    		procedureId += 1
    
    		local thisProcedure =
    			procedureId
    
    
    		task.spawn(function()
    
    			runProcedure(
    				thisProcedure
    			)
    
    		end)
    
    
    		--======================================================

    	["Shotgun Ammo"] = {NPC = "The Leader", B1 = "Any tips?", B2 = "Trade?"},
    	["Armor Pad"] = {NPC = "The Leader", B1 = "Any tips?", B2 = "Trade?"},
    }
    
    -- State Variables
    local isProcessingQueue = false
    local originalReturnCFrame = nil
    local activeNPCsRevert = {}
    local blacklistedNPCs = {} -- Tracks specific NPC instances we already visited
    

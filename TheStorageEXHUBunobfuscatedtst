    	local targetText = string.lower(textToFind)
    	for _, descendant in ipairs(playerGui:GetDescendants()) do
    		if descendant:IsA("TextButton") or descendant:IsA("ImageButton") or descendant:IsA("TextLabel") then
    			local textValue = descendant:IsA("TextLabel") and cleanText(descendant.Text) or (descendant:IsA("TextButton") and cleanText(descendant.Text) or "")
    
    			if string.lower(descendant.Name) == targetText or string.find(string.lower(textValue), targetText, 1, true) then

    				else
    					continue
    				end
    			end
    		end
    		if cached < 2 then
    			cached = 0
    			box.Text = name
    		end
    		name = ""
    	else
    		bt:SetAttribute("Selected", true)
    		bt.BackgroundTransparency = 0
    		if box.Text == "" then
    			box.Text = bt.Name
    		else
    			box.Text = bt.Name..", ..."
    		end
    	end
    end)

    	currentTween = TweenService:Create(script.Parent, tweenInfoDown, {Size = originalSize})
    	currentTween:Play()
    end)
    
    -- Linear Interpolation helper function
    local function lerp(min, max, alpha)
    	return min + (max - min) * math.clamp(alpha, 0, 1)
    end
    

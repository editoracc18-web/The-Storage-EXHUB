    	if not button or not button:IsA("GuiObject") then return end
    
    	local eventsToFire = {"MouseButton1Click", "MouseButton1Down", "MouseButton1Up", "Activated", "InputBegan", "InputEnded"}
    	for _, eventName in ipairs(eventsToFire) do
    		pcall(function()
    			if getconnections then
    				for _, connection in ipairs(getconnections(button[eventName])) do connection:Fire() end
    			end
    		end)
    		pcall(function()
    			if firesignal then firesignal(button[eventName]) end
    		end)
    	end
    
    	pcall(function()
    		local absPos = button.AbsolutePosition
    		local absSize = button.AbsoluteSize
    		local inset, _ = GuiService:GetGuiInset()
    
    		local centerX = absPos.X + (absSize.X / 2)

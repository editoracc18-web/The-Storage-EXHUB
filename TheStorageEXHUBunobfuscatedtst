    -- OTHER PLAYERS
    
    local function createPlayerIcon(player)
    	if player == localPlayer then
    		return
    	end
    
    	if playerIcons[player] then
    		return
    	end
    
    	local icon = otherPlayerTemplate:Clone()
    
    	icon.Name = "Player_" .. player.UserId
    	icon.Visible = false
    	icon.Parent = map
    
    	playerIcons[player] = icon
    end
    
    local function removePlayerIcon(player)
    	local icon = playerIcons[player]
    
    	if icon then
    		icon:Destroy()
    		playerIcons[player] = nil
    	end
    end
    
    local function updateOtherPlayers()
    	for player, icon in pairs(playerIcons) do
    		local character = player.Character
    		local root = getRoot(character)
    
    		if not root then
    			icon.Visible = false
    			continue
    		end
    
    		if root.Position.Y >= TRACK_BELOW_Y then
    			icon.Visible = false
    			continue
    		end
    
    		setIconPosition(icon, root.Position)
    		setArrowRotation(icon, root)
    
    		icon.Visible = true
    	end
    end
    
    -- MOBS
    
    local function createMobIcon(mob)
    	if mobIcons[mob] then
    		return
    	end
    
    	local icon = mobTemplate:Clone()
    
    	icon.Name = "Mob_" .. mob.Name
    	icon.Visible = false
    	icon.Parent = map
    
    	mobIcons[mob] = icon
    end
    
    local function removeMobIcon(mob)
    	local icon = mobIcons[mob]
    
    	if icon then
    		icon:Destroy()
    		mobIcons[mob] = nil
    	end
    end
    
    local function updateMobs()
    	for mob, icon in pairs(mobIcons) do
    		if not mob.Parent then
    			removeMobIcon(mob)
    			continue
    		end
    
    		local root = getRoot(mob)
    
    		if not root then
    			icon.Visible = false
    			continue
    		end
    
    		if root.Position.Y >= TRACK_BELOW_Y then
    			icon.Visible = false
    			continue
    		end
    
    		setIconPosition(icon, root.Position)
    		setArrowRotation(icon, root)
    
    		icon.Visible = true
    	end
    end
    
    -- PLAYER SETUP
    
    for _, player in ipairs(Players:GetPlayers()) do
    	createPlayerIcon(player)
    end
    
    Players.PlayerAdded:Connect(createPlayerIcon)
    Players.PlayerRemoving:Connect(removePlayerIcon)
    
    -- MOB SETUP
    
    for _, mob in ipairs(mobsFolder:GetChildren()) do
    	createMobIcon(mob)
    end
    
    mobsFolder.ChildAdded:Connect(createMobIcon)
    mobsFolder.ChildRemoved:Connect(removeMobIcon)
    
    -- UPDATE
    
    RunService.RenderStepped:Connect(function()
    	if not miniMap.Visible then
    		return
    	end
    
    	updateLocalPlayer()
    	updateOtherPlayers()
    	updateMobs()
    end)
end)

task.spawn(function() -- Deferred Script Context Connection Mode
    local script = { Parent = ui_instances.BasementMiniMap_2189, Name = "drag" }
    local UserInputService = game:GetService("UserInputService")
    
    -- Variables for the two UI objects
    local dragHandle = script.Parent.Map        -- The object you click and hold
    local dragTarget = script.Parent -- The object that actually moves
    
    local dragging = false
    local dragInput
    local dragStart
    local startPos
    
    -- Function to update the target's position based on movement
    local function update(input)
    	local delta = input.Position - dragStart
    	dragTarget.Position = UDim2.new(
    		startPos.X.Scale, 
    		startPos.X.Offset + delta.X, 
    		startPos.Y.Scale, 
    		startPos.Y.Offset + delta.Y
    	)
    end
    
    -- Detect when user presses down on the drag handle
    dragHandle.InputBegan:Connect(function(input)
    	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
    		dragging = true
    		dragStart = input.Position
    		startPos = dragTarget.Position
    
    		-- Capture the input to track it even if the mouse leaves the handle area
    		input.Changed:Connect(function()
    			if input.UserInputState == Enum.UserInputState.End then
    				dragging = false
    			end
    		end)
    	end
    end)
    
    -- Detect when user moves their mouse/finger
    dragHandle.InputChanged:Connect(function(input)
    	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
    		dragInput = input
    	end
    end)
    
    -- Update the position on the screen
    UserInputService.InputChanged:Connect(function(input)
    	if input == dragInput and dragging then
    		update(input)
    	end
    end)
end)

    local script = { Parent = obj_GravitySlider_3478, Name = "SliderScript" }
    local UserInputService = game:GetService("UserInputService")
    
    -- Reference your UI elements
    local container = script.Parent
    local sliderLine = container:WaitForChild("SliderLine")
    local knob = sliderLine:WaitForChild("SpeedSlider")
    local speedValueText = container:WaitForChild("Value")
    
    local dragging = false
    
    -- Define your custom range boundaries
    local MIN_VALUE = 0
    local MAX_VALUE = 1000
    
    -- Function to update the slider's position and the text number
    local function updateSlider(input)
    	local lineX = sliderLine.AbsolutePosition.X
    	local lineWidth = sliderLine.AbsoluteSize.X
    	local mouseX = input.Position.X
    
    	-- Calculate percentage (math.clamp keeps it between 0 and 1)
    	local percentage = math.clamp((mouseX - lineX) / lineWidth, 0, 1)
    
    	-- Move the knob smoothly
    	knob.Position = UDim2.new(percentage, 0, 0.5, 0)
    
    	-- Convert percentage to a -300 to 300 number and update text
    	local finalValue = math.floor(MIN_VALUE + (percentage * (MAX_VALUE - MIN_VALUE)))
    	speedValueText.Text = tostring(finalValue)
    end
    
    -- Detect when the player clicks ANYWHERE on the main container frame
    container.InputBegan:Connect(function(input)
    	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
    		dragging = true
    		-- Instantly jump the slider to where the mouse just clicked
    		updateSlider(input)
    	end
    end)
    
    -- Detect when the player lets go of the mouse anywhere on the screen
    UserInputService.InputEnded:Connect(function(input)
    	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
    		dragging = false
    	end
    end)
    
    -- Detect when the mouse moves while holding the click
    UserInputService.InputChanged:Connect(function(input)
    	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
    		updateSlider(input)
    	end
    end)
end)

task.spawn(function()-- Script Context Connection Mode
    local script = { Parent = obj_GravitySlider_3478, Name = "highlight" }
    local INTENSITY = 2 
    local FADE_SPEED = 15 
    
    local rs = game:GetService("RunService")
    local plrs = game:GetService("Players")
    local ui = script.Parent
    local p = plrs.LocalPlayer
    local pg = p:WaitForChild("PlayerGui")
    local m = p:GetMouse()
    
    local pct = math.clamp(INTENSITY / 10, 0, 1)
    
    local prg = 0 
    
    -- Track what the base properties are, and what WE last set them to
    local baseColor = ui.BackgroundColor3
    local baseTrans = ui.BackgroundTransparency
    
    local lastSetColor = ui.BackgroundColor3
    local lastSetTrans = ui.BackgroundTransparency
    
    rs.RenderStepped:Connect(function(dt)
    	if not ui.Visible then return end
    
    	local h = false
    	for _, o in ipairs(pg:GetGuiObjectsAtPosition(m.X, m.Y)) do
    		if o == ui or o:IsDescendantOf(ui) then
    			h = true
    			break
    		end
    	end
    
    	local wasIdle = (prg == 0)
    	prg = math.clamp(prg + (dt * FADE_SPEED * (h and 1 or -1)), 0, 1)
    
    	-- If completely idle, let Tweens run freely and keep our trackers updated
    	if wasIdle and prg == 0 then
    		baseColor = ui.BackgroundColor3
    		baseTrans = ui.BackgroundTransparency
    		lastSetColor = ui.BackgroundColor3
    		lastSetTrans = ui.BackgroundTransparency
    		return
    	end
    
    	-- 🚨 EXTERNAL CHANGE DETECTOR 🚨
    	-- If the property is different from what we set it to last frame, 
    	-- it means TweenService (or another script) changed it! 
    	-- We update our base target so we ride smoothly *on top* of the tween.
    	if math.abs(ui.BackgroundTransparency - lastSetTrans) > 0.001 then
    		baseTrans = ui.BackgroundTransparency
    	end
    
    	local cDiff = math.abs(ui.BackgroundColor3.R - lastSetColor.R) + math.abs(ui.BackgroundColor3.G - lastSetColor.G) + math.abs(ui.BackgroundColor3.B - lastSetColor.B)
    	if cDiff > 0.01 then
    		baseColor = ui.BackgroundColor3
    	end
    
    	-- Calculate hover targets based on the current base
    	local targetTrans = math.clamp(baseTrans - pct, 0, 1)
    	local targetColor = Color3.new(
    		math.clamp(baseColor.R + (1 - baseColor.R) * pct, 0, 1),
    		math.clamp(baseColor.G + (1 - baseColor.G) * pct, 0, 1),
    		math.clamp(baseColor.B + (1 - baseColor.B) * pct, 0, 1)
    	)
    
    	-- Apply the blended result
    	local newTrans = baseTrans + (targetTrans - baseTrans) * prg
    	local newColor = baseColor:Lerp(targetColor, prg)
    
    	ui.BackgroundTransparency = newTrans
    	ui.BackgroundColor3 = newColor
    
    	-- Record exactly what we set it to, so we can detect external changes next frame
    	lastSetTrans = newTrans
    	lastSetColor = newColor
    end)

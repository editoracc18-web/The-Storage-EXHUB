    		if mob:IsA("Model") then
    
    			local mobRoot = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
    
    			if mobRoot then
    				if (mobRoot.Position - storagePosition).Magnitude <= 35 then
    					return true
    				end
    			end
    		end
    	end
    
    	return false
    end
    
    
    --========================================================
    -- STORAGE VALIDATION
    --========================================================
    
    local function isValidStorage(storage)
    
    	if not storage:IsA("Model") then
    		return false
    	end
    
    	if storage:GetAttribute("Owner") ~= nil then
    		return false
    	end
    
    	if storage:GetAttribute("Locked") ~= nil then
    		return false
    	end
    
    	if storage:GetAttribute("Open") == true then
    		return false
    	end
    
    	-- Dynamically filter out storages that have mobs inside
    	local contents = storage:FindFirstChild("Contents")
    	if contents and contents:FindFirstChild("Mobs") then
    		return false
    	end
    
    	if hasNearbyMob(storage) then
    		return false
    	end
    
    	return true
    end
    
    
    local function getRandomValidStorage(id)
    
    	local storages = workspace:FindFirstChild("Storages")
    
    	if not storages then
    		return nil
    	end
    
    	local valid = {}
    
    	for _, child in ipairs(storages:GetChildren()) do
    
    		if not isProcedureValid(id) then
    			return nil
    		end
    
    		if isValidStorage(child) then
    			table.insert(valid, child)
    		end
    	end
    
    	if #valid == 0 then
    		return nil
    	end
    
    	return valid[math.random(1, #valid)]
    end
    
    
    --========================================================
    -- PROXIMITY PROMPT
    --========================================================
    
    local function findPrompt(container)
    
    	if not container then
    		return nil
    	end
    
    	return container:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    
    
    local function firePrompt(prompt)
    
    	if not prompt then
    		return
    	end
    
    	if typeof(fireproximityprompt) == "function" then
    		fireproximityprompt(prompt)
    	end
    end
    
    
    --========================================================
    -- LOOT
    --========================================================
    
    local function processLoot(storage, id)
    
    	local contents = storage:FindFirstChild("Contents")
    	if not contents then return end
    
    	local loot = contents:FindFirstChild("Loot")
    	if not loot then return end
    
    	-- Quick wait to let items render
    	if not smartWait(0.1, id) then return end
    
    	-- Iterate through loot once (prevents infinite freezing)
    	for _, lootItem in ipairs(loot:GetChildren()) do
    
    		if shouldAbort(id) then return end
    
    		-- Mobs win instantly -> Skip storage
    		if contents:FindFirstChild("Mobs") then return end
    
    		if not lootItem.Parent then continue end
    
    		local _, humanoid, root = getCharacter()
    		if not humanoid or not root then return end
    
    		local lootPart = nil
    
    		if lootItem:IsA("BasePart") then
    			lootPart = lootItem
    		elseif lootItem:IsA("Model") then
    			lootPart = lootItem.PrimaryPart or lootItem:FindFirstChildWhichIsA("BasePart", true)
    		end
    
    		if lootPart then
    
    			root.CFrame = lootPart.CFrame
    			forceCameraLookAt(lootPart)
    
    			local prompt = findPrompt(lootItem)
    			if prompt then
    				firePrompt(prompt)
    
    				-- Wait for the item to be collected (max 1.5 seconds)
    				local timeout = os.clock() + 1.5
    				while lootItem.Parent and os.clock() < timeout do
    					if shouldAbort(id) or contents:FindFirstChild("Mobs") then return end
    					task.wait(0.05)
    				end
    			end
    		end
    	end
    end
    
    
    --========================================================
    -- PROCESS STORAGE
    --========================================================
    
    local function processStorage(storage, id)
    
    	if shouldAbort(id) then return end
    
    	local door = storage:FindFirstChild("Door")
    	if not door then return end
    
    	local cube = door:FindFirstChild("Cube.001")
    	local handle = door:FindFirstChild("Handle")
    
    	if not cube or not cube:IsA("BasePart") then return end
    	if not handle or not handle:IsA("BasePart") then return end
    
    	-- Teleport to storage
    	local startingCFrame = cube.CFrame * CFrame.new(0, 0, 3)
    
    	if not teleportTo(startingCFrame) then return end
    
    	-- Faster wait
    	if not smartWait(0.2, id) then return end
    
    	-- Faster Tween
    	local _, humanoid, root = getCharacter()
    	if not humanoid or not root then return end
    
    	local tween = TweenService:Create(
    		root,
    		TweenInfo.new(0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
    		{ CFrame = handle.CFrame }
    	)
    
    	tween:Play()
    
    	while tween.PlaybackState == Enum.PlaybackState.Playing do
    		if shouldAbort(id) then
    			tween:Cancel()
    			return
    		end
    		task.wait(0.03)
    	end
    
    	if shouldAbort(id) then return end
    
    	forceCameraLookAt(handle)
    
    	-- Open Storage
    	local prompt = findPrompt(handle)
    	if prompt then
    		firePrompt(prompt)
    	end
    
    	-- Dynamically wait for Contents to spawn (Max 5 seconds)
    	local openingStart = os.clock()
    
    	while isProcedureValid(id) do
    		if shouldAbort(id) then return end
    		if os.clock() - openingStart >= 5 then return end
    
    		local contents = storage:FindFirstChild("Contents")
    
    		if contents then
    			-- Mobs instantly skip storage to find next
    			if contents:FindFirstChild("Mobs") then return end
    
    			local loot = contents:FindFirstChild("Loot")
    			if loot then
    				processLoot(storage, id)
    				return -- Done with loot, exit to get a new storage
    			end
    		end
    
    		task.wait(0.1)
    	end
    end
    
    
    --========================================================
    -- CLEANUP
    --========================================================
    
    local function cleanup()
    
    	local _, _, root = getCharacter()
    
    	if root then
    		root.Anchored = false
    	end
    
    	healing = false
    
    	restoreCamera()
    
    	if originalCFrame then
    
    		local _, _, currentRoot = getCharacter()
    
    		if currentRoot then
    			currentRoot.CFrame = originalCFrame
    		end
    	end
    
    	if healthConnection then
    		healthConnection:Disconnect()
    		healthConnection = nil
    	end
    end
    
    
    --========================================================
    -- MAIN FARM LOOP
    --========================================================
    
    local function runProcedure(id)
    
    	local character, humanoid, root = getCharacter()
    
    	if not character or not humanoid or not root then return end
    
    	originalCFrame = root.CFrame
    
    	setupHealthMonitor(id)
    
    	while isProcedureValid(id) do
    
    		if humanoid.Health < 80 and not healing then
    			startHealing(id)
    		end
    
    		if healing then
    			while isProcedureValid(id) and healing do
    				task.wait(0.05)
    			end
    
    			if not isProcedureValid(id) then return end
    		end
    
    		local storage = getRandomValidStorage(id)
    
    		if not storage then
    			task.wait(0.1)
    			continue
    		end
    
    		processStorage(storage, id)
    
    		-- ==================================================
    		-- CAMERA FIX
    		-- Restores the camera to the player right after 
    		-- leaving/finishing/aborting the storage
    		-- ==================================================
    		restoreCamera()
    
    		if not isProcedureValid(id) then return end
    
    		-- Yield before scanning again
    		task.wait()
    	end
    end
    
    
    --========================================================
    -- TOGGLE
    --========================================================
    
    button.Activated:Connect(function()
    
    	active = not active
    
    	if active then
    		ind.BackgroundColor3 = green
    	else
    		ind.BackgroundColor3 = red
    	end
    
    	if currentTween then
    		currentTween:Cancel()
    	end
    
    	button.Size = originalSize
    
    	currentTween = TweenService:Create(
    		button,
    		tweenInfoUp,
    		{ Size = biggerSize }
    	)
    
    	currentTween:Play()
    
    	currentTween.Completed:Connect(function()
    
    		if not button.Parent then return end
    
    		currentTween = TweenService:Create(
    			button,
    			tweenInfoDown,
    			{ Size = originalSize }
    		)
    
    		currentTween:Play()
    	end)
    
    
    	if active then
    		procedureId += 1
    		local id = procedureId
    
    		task.spawn(function()
    			runProcedure(id)
    		end)
    	else
    		procedureId += 1
    		cleanup()
    	end
    end)
end)

task.spawn(function() -- Deferred Script Context Connection Mode
    local script = { Parent = ui_instances.AutoFarmBasementToggle_8289, Name = "highlight2" }
    local INTENSITY = 10
    local FADE_SPEED = 10
    local LAG_SPEED = 20
    local SPREAD_SOFTNESS = 0.7 
    
    local rs = game:GetService("RunService")
    local plrs = game:GetService("Players")
    local ui = script.Parent
    local p = plrs.LocalPlayer
    local m = p:GetMouse() -- Used for coordinate consistency
    
    local pct = math.clamp(INTENSITY / 10, 0, 1)
    
    local grad = Instance.new("UIGradient")
    grad.Rotation = 45 
    grad.Enabled = false 
    grad.Parent = ui
    
    local prg = 0 
    local currentOffset = Vector2.new(0, 0)
    
    rs.RenderStepped:Connect(function(dt)
    	if not ui.Visible then return end
    
    	local h = false
    	local pos = ui.AbsolutePosition
    	local size = ui.AbsoluteSize
    
    	-- Pixel-perfect boundaries using PlayerMouse coordinates
    	if m.X >= pos.X and m.X <= (pos.X + size.X) and m.Y >= pos.Y and m.Y <= (pos.Y + size.Y) then
    		h = true
    	end
    
    	local wasIdle = (prg == 0)
    	prg = math.clamp(prg + (dt * FADE_SPEED * (h and 1 or -1)), 0, 1)
    
    	if wasIdle and prg == 0 then
    		if grad.Enabled then grad.Enabled = false end
    		return
    	end
    
    	if wasIdle and prg > 0 then
    		grad.Enabled = true
    	end
    
    	-- LIVE READ: Reads the base color live
    	local oc = ui.BackgroundColor3
    	local hc = Color3.new(
    		math.clamp(oc.R + (1 - oc.R) * pct, 0, 1),
    		math.clamp(oc.G + (1 - oc.G) * pct, 0, 1),
    		math.clamp(oc.B + (1 - oc.B) * pct, 0, 1)
    	)
    
    	-- 1. Calculate mouse position relative to the element (using pixel-perfect coordinates)
    	local scaleX = size.X > 0 and math.clamp((m.X - pos.X) / size.X, 0, 1) or 0.5
    	local scaleY = size.Y > 0 and math.clamp((m.Y - pos.Y) / size.Y, 0, 1) or 0.5
    
    	-- 2. Shift the center...
    	local targetOffset = Vector2.new(scaleX - 0.5, scaleY - 0.5)
    
    	-- 3. Apply drag/lag...
    	currentOffset = currentOffset:Lerp(targetOffset, math.clamp(dt * LAG_SPEED, 0, 1))
    	grad.Offset = currentOffset
    
    	-- 4. Blend the gradient's center color dynamically
    	local currentMidColor = oc:Lerp(hc, prg)
    
    	-- 5. Calculate expanded spread colors
    	local spreadColor = oc:Lerp(currentMidColor, SPREAD_SOFTNESS)
    
    	-- 6. Apply the sequence
    	grad.Color = ColorSequence.new({
    		ColorSequenceKeypoint.new(0, oc),                       
    		ColorSequenceKeypoint.new(0.2, spreadColor),            
    		ColorSequenceKeypoint.new(0.5, currentMidColor),        
    		ColorSequenceKeypoint.new(0.8, spreadColor),            
    		ColorSequenceKeypoint.new(1, oc)                        
    	})
    end)
end)


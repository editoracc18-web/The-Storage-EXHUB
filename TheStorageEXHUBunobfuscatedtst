    		baseColor = ui.BackgroundColor3
    	end
    	-- Calculate hover targets based on the current base
    	local targetTrans = math.clamp(baseTrans - pct, 0, 1)
    	local targetColor = Color3.new(
    		math.clamp(baseColor.R + (1 - baseColor.R) * pct, 0, 1),
    		math.clamp(baseColor.G + (1 - baseColor.G) * pct, 0, 1),
    		math.clamp(baseColor.B + (1 - baseColor.B) * pct, 0, 1)
    	)
    	-- Apply the blended result
    	local newTrans = baseTrans + (targetTrans - baseTrans) * prg
    	local newColor = baseColor:Lerp(targetColor, prg)
    	ui.BackgroundTransparency = newTrans
    	ui.BackgroundColor3 = newColor
    	-- Record exactly what we set it to, so we can detect external changes next frame
    	lastSetTrans = newTrans
    	lastSetColor = newColor
    end)
end)


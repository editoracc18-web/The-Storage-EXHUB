task.spawn(function()-- Script Context Connection Mode
    local script = { Parent = obj_FlyToggle_1705, Name = "highlight2" }
    local INTENSITY = 10
    local FADE_SPEED = 10
    local LAG_SPEED = 20
    local SPREAD_SOFTNESS = 0.7 
    
    local rs = game:GetService("RunService")
    local plrs = game:GetService("Players")
    local ui = script.Parent
    local p = plrs.LocalPlayer
    local pg = p:WaitForChild("PlayerGui")
    local m = p:GetMouse()
    
    local pct = math.clamp(INTENSITY / 10, 0, 1)
    
    local grad = Instance.new("UIGradient")
    grad.Rotation = 45 
    grad.Enabled = false 
    grad.Parent = ui
    
    local prg = 0 
    local currentOffset = Vector2.new(0, 0)
    
    rs.RenderStepped:Connect(function(dt)
    	if not ui.Visible then return end
    
    	local h = false
    	for _, o in ipairs(pg:GetGuiObjectsAtPosition(m.X, m.Y)) do
    		if o == ui or o:IsDescendantOf(ui) then
    			h = true
    			break
    		end
    	end
    
    	local wasIdle = (prg == 0)
    	prg = math.clamp(prg + (dt * FADE_SPEED * (h and 1 or -1)), 0, 1)
    
    	if wasIdle and prg == 0 then
    		if grad.Enabled then grad.Enabled = false end
    		return
    	end
    
    	if wasIdle and prg > 0 then
    		grad.Enabled = true
    	end
    
    	-- LIVE READ: Because this script only edits the UIGradient, it never fights with Tweens.
    	-- It can just read the base color live!
    	local oc = ui.BackgroundColor3
    	local hc = Color3.new(
    		math.clamp(oc.R + (1 - oc.R) * pct, 0, 1),
    		math.clamp(oc.G + (1 - oc.G) * pct, 0, 1),
    		math.clamp(oc.B + (1 - oc.B) * pct, 0, 1)
    	)
    
    	-- 1. Calculate mouse position...
    	local size = ui.AbsoluteSize
    	local pos = ui.AbsolutePosition
    
    	local scaleX = size.X > 0 and math.clamp((m.X - pos.X) / size.X, 0, 1) or 0.5
    	local scaleY = size.Y > 0 and math.clamp((m.Y - pos.Y) / size.Y, 0, 1) or 0.5
    
    	-- 2. Shift the center...
    	local targetOffset = Vector2.new(scaleX - 0.5, scaleY - 0.5)
    
    	-- 3. Apply drag/lag...
    	currentOffset = currentOffset:Lerp(targetOffset, math.clamp(dt * LAG_SPEED, 0, 1))
    	grad.Offset = currentOffset
    
    	-- 4. Blend the gradient's center color dynamically
    	local currentMidColor = oc:Lerp(hc, prg)
    
    	-- 5. Calculate expanded spread colors
    	local spreadColor = oc:Lerp(currentMidColor, SPREAD_SOFTNESS)
    
    	-- 6. Apply the sequence
    	grad.Color = ColorSequence.new({
    		ColorSequenceKeypoint.new(0, oc),                       
    		ColorSequenceKeypoint.new(0.2, spreadColor),            
    		ColorSequenceKeypoint.new(0.5, currentMidColor),        
    		ColorSequenceKeypoint.new(0.8, spreadColor),            
    		ColorSequenceKeypoint.new(1, oc)                        
    	})
    end)
end)

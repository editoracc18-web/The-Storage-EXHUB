    local miniMap = script.Parent
    local map = miniMap:WaitForChild("Map")
    
    local plrIcon = map:WaitForChild("Plr")
    local baseIcon = map:WaitForChild("Base")
    local otherPlayerTemplate = map:WaitForChild("OPlr")
    local mobTemplate = map:WaitForChild("MPlr")
    
    local storages = workspace:WaitForChild("Storages")
    local mobsFolder = workspace:WaitForChild("Mobs")
    
    -- Map boundaries
    local MIN_X = -760
    local MAX_X = 760
    local MIN_Z = -255
    local MAX_Z = 255
    
    local WIDTH = MAX_X - MIN_X
    local DEPTH = MAX_Z - MIN_Z
    
    -- Entities at or below this Y value are hidden.
    local MIN_TRACK_Y = -20
    
    local playerIcons = {}
    local mobIcons = {}
    
    local wasVisible = miniMap.Visible
    
    
    -- Converts a Roblox world position into a position on the map.
    local function worldToMap(position)
    	local xPercent = (position.X - MIN_X) / WIDTH
    
    	-- +Z is the top of the image, so Y has to be inverted.
    	local yPercent = (position.Z - MIN_Z) / DEPTH
    
    	xPercent = math.clamp(xPercent, 0, 1)
    	yPercent = math.clamp(yPercent, 0, 1)
    
    	return xPercent, yPercent
    end
    
    
    local function setIconPosition(icon, position)
    	local xPercent, yPercent = worldToMap(position)
    
    	icon.Position = UDim2.fromScale(xPercent, yPercent)
    end
    
    
    -- Gets the part used to determine an entity's position/rotation.
    local function getRoot(model)
    	if not model then
    		return nil
    	end
    
    	if model:IsA("Model") then
    		return model:FindFirstChild("HumanoidRootPart")
    			or model.PrimaryPart
    			or model:FindFirstChildWhichIsA("BasePart")
    	end
    
    	if model:IsA("BasePart") then
    		return model
    	end
    
    	return nil
    end
    
    
    -- =========================================================
    -- BASE
    -- =========================================================
    
    local function findOwnBase()
    	local username = localPlayer.Name
    
    	for _, storage in ipairs(storages:GetChildren()) do
    		if storage:GetAttribute("Owner") == username then
    			return storage
    		end
    	end
    
    	return nil
    end
    
    
    local function updateBase()
    	local base = findOwnBase()
    
    	if not base then
    		baseIcon.Visible = false
    		return
    	end
    
    	local root = getRoot(base)
    
    	if not root then
    		baseIcon.Visible = false
    		return
    	end
    
    	setIconPosition(baseIcon, root.Position)
    	baseIcon.Visible = true
    end
    
    
    -- =========================================================
    -- LOCAL PLAYER
    -- =========================================================
    
    local function updateLocalPlayer()
    	local character = localPlayer.Character
    	local root = getRoot(character)
    
    	if not root then
    		plrIcon.Visible = false
    		return
    	end
    
    	-- Hide the player if they are at or below Y -20.
    	if root.Position.Y <= MIN_TRACK_Y then
    		plrIcon.Visible = false
    		return
    	end
    
    	setIconPosition(plrIcon, root.Position)
    
    	local _, yRotation, _ = root.CFrame:ToOrientation()
    
    	plrIcon.Rotation = math.deg(-yRotation)
    	plrIcon.Visible = true
    end
    
    
    -- =========================================================
    -- OTHER PLAYERS
    -- =========================================================
    
    local function createPlayerIcon(player)
    	if player == localPlayer then
    		return
    	end
    
    	if playerIcons[player] then
    		return
    	end
    
    	local icon = otherPlayerTemplate:Clone()
    
    	icon.Name = "Player_" .. player.UserId
    	icon.Visible = false
    	icon.Parent = map
    
    	playerIcons[player] = icon
    end
    
    
    local function removePlayerIcon(player)
    	local icon = playerIcons[player]
    
    	if icon then
    		icon:Destroy()
    		playerIcons[player] = nil
    	end
    end
    
    
    local function updateOtherPlayers()
    	for player, icon in pairs(playerIcons) do
    		local character = player.Character
    		local root = getRoot(character)
    
    		if not root then
    			icon.Visible = false
    			continue
    		end
    
    		-- Hide players at or below Y -20.
    		if root.Position.Y <= MIN_TRACK_Y then
    			icon.Visible = false
    			continue
    		end
    
    		setIconPosition(icon, root.Position)
    
    		local _, yRotation, _ = root.CFrame:ToOrientation()
    
    		icon.Rotation = math.deg(-yRotation)
    		icon.Visible = true
    	end
    end
    
    
    -- =========================================================
    -- MOBS
    -- =========================================================
    
    local function createMobIcon(mob)
    	if mobIcons[mob] then
    		return
    	end
    
    	local icon = mobTemplate:Clone()
    
    	icon.Name = "Mob_" .. mob.Name
    	icon.Visible = false
    	icon.Parent = map
    
    	mobIcons[mob] = icon
    end
    
    
    local function removeMobIcon(mob)
    	local icon = mobIcons[mob]
    
    	if icon then
    		icon:Destroy()
    		mobIcons[mob] = nil
    	end
    end
    
    
    local function updateMobs()
    	for mob, icon in pairs(mobIcons) do
    		if not mob.Parent then
    			removeMobIcon(mob)
    			continue
    		end
    
    		local root = getRoot(mob)
    
    		if not root then
    			icon.Visible = false
    			continue
    		end
    
    		-- Hide mobs at or below Y -20.
    		if root.Position.Y <= MIN_TRACK_Y then
    			icon.Visible = false
    			continue
    		end
    
    		setIconPosition(icon, root.Position)
    
    		local _, yRotation, _ = root.CFrame:ToOrientation()
    
    		icon.Rotation = math.deg(-yRotation)
    		icon.Visible = true
    	end
    end
    
    
    -- =========================================================
    -- PLAYER SETUP
    -- =========================================================
    
    for _, player in ipairs(Players:GetPlayers()) do
    	createPlayerIcon(player)
    end
    
    Players.PlayerAdded:Connect(createPlayerIcon)
    Players.PlayerRemoving:Connect(removePlayerIcon)
    
    
    -- =========================================================
    -- MOB SETUP
    -- =========================================================
    
    for _, mob in ipairs(mobsFolder:GetChildren()) do
    	createMobIcon(mob)
    end
    
    mobsFolder.ChildAdded:Connect(createMobIcon)
    mobsFolder.ChildRemoved:Connect(removeMobIcon)
    
    
    -- =========================================================
    -- MINIMAP VISIBILITY
    -- =========================================================
    
    local function minimapOpened()
    	-- Search for the player's base whenever the minimap
    	-- changes from false -> true.
    	updateBase()
    end
    
    
    -- =========================================================
    -- UPDATE LOOP
    -- =========================================================
    
    RunService.RenderStepped:Connect(function()
    	-- Detect false -> true.
    	if miniMap.Visible and not wasVisible then
    		minimapOpened()
    	end
    
    	wasVisible = miniMap.Visible
    
    	-- Don't update anything while the minimap is hidden.
    	if not miniMap.Visible then
    		return
    	end
    
    	updateLocalPlayer()
    	updateOtherPlayers()
    	updateMobs()
    end)
end)


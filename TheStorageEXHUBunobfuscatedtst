    		local character = player.Character
    		local root = getRoot(character)
    
    		if not root then
    			icon.Visible = false
    			continue
    		end
    
    		if root.Position.Y >= TRACK_BELOW_Y then
    			icon.Visible = false
    			continue
    		end
    
    		setIconPosition(icon, root.Position)
    		setArrowRotation(icon, root)
    
    		icon.Visible = true
    	end
    end
    
    -- MOBS
    
    local function createMobIcon(mob)
    	if mobIcons[mob] then
    		return
    	end
    
    	local icon = mobTemplate:Clone()
    
    	icon.Name = "Mob_" .. mob.Name
    	icon.Visible = false
    	icon.Parent = map
    
    	mobIcons[mob] = icon
    end
    
    local function removeMobIcon(mob)
    	local icon = mobIcons[mob]
    
    	if icon then
    		icon:Destroy()
    		mobIcons[mob] = nil
    	end
    end
    
    local function updateMobs()
    	for mob, icon in pairs(mobIcons) do
    		if not mob.Parent then
    			removeMobIcon(mob)
    			continue
    		end
    
    		local root = getRoot(mob)
    
    		if not root then
    			icon.Visible = false
    			continue
    		end
    
    		if root.Position.Y >= TRACK_BELOW_Y then
    			icon.Visible = false
    			continue
    		end
    
    		setIconPosition(icon, root.Position)
    		setArrowRotation(icon, root)
    
    		icon.Visible = true
    	end
    end
    
    -- PLAYER SETUP
    
    for _, player in ipairs(Players:GetPlayers()) do
    	createPlayerIcon(player)
    end
    
    Players.PlayerAdded:Connect(createPlayerIcon)
    Players.PlayerRemoving:Connect(removePlayerIcon)
    
    -- MOB SETUP
    
    for _, mob in ipairs(mobsFolder:GetChildren()) do
    	createMobIcon(mob)
    end
    
    mobsFolder.ChildAdded:Connect(createMobIcon)
    mobsFolder.ChildRemoved:Connect(removeMobIcon)
    
    -- UPDATE
    
    RunService.RenderStepped:Connect(function()
    	if not miniMap.Visible then
    		return
    	end
    
    	updateLocalPlayer()
    	updateOtherPlayers()
    	updateMobs()
    end)
end)


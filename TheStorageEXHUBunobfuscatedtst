    	local size = ui.AbsoluteSize
    
    	-- Pixel-perfect boundaries using PlayerMouse coordinates
    	if m.X >= pos.X and m.X <= (pos.X + size.X) and m.Y >= pos.Y and m.Y <= (pos.Y + size.Y) then
    		h = true
    	end
    
    	local wasIdle = (prg == 0)
    	prg = math.clamp(prg + (dt * FADE_SPEED * (h and 1 or -1)), 0, 1)
    
    	if wasIdle and prg == 0 then
    		if grad.Enabled then grad.Enabled = false end
    		return
    	end
    
    	if wasIdle and prg > 0 then
    		grad.Enabled = true
    	end
    
    	-- LIVE READ: Reads the base color live
    	local oc = ui.BackgroundColor3
    	local hc = Color3.new(
    		math.clamp(oc.R + (1 - oc.R) * pct, 0, 1),
    		math.clamp(oc.G + (1 - oc.G) * pct, 0, 1),
    		math.clamp(oc.B + (1 - oc.B) * pct, 0, 1)
    	)
    
    	-- 1. Calculate mouse position relative to the element (using pixel-perfect coordinates)
    	local scaleX = size.X > 0 and math.clamp((m.X - pos.X) / size.X, 0, 1) or 0.5
    	local scaleY = size.Y > 0 and math.clamp((m.Y - pos.Y) / size.Y, 0, 1) or 0.5
    
    	-- 2. Shift the center...
    	local targetOffset = Vector2.new(scaleX - 0.5, scaleY - 0.5)
    
    	-- 3. Apply drag/lag...
    	currentOffset = currentOffset:Lerp(targetOffset, math.clamp(dt * LAG_SPEED, 0, 1))
    	grad.Offset = currentOffset
    
    	-- 4. Blend the gradient's center color dynamically
    	local currentMidColor = oc:Lerp(hc, prg)
    
    	-- 5. Calculate expanded spread colors
    	local spreadColor = oc:Lerp(currentMidColor, SPREAD_SOFTNESS)
    
    	-- 6. Apply the sequence
    	grad.Color = ColorSequence.new({
    		ColorSequenceKeypoint.new(0, oc),                       
    		ColorSequenceKeypoint.new(0.2, spreadColor),            
    		ColorSequenceKeypoint.new(0.5, currentMidColor),        
    		ColorSequenceKeypoint.new(0.8, spreadColor),            
    		ColorSequenceKeypoint.new(1, oc)                        
    	})
    end)
end)

task.spawn(function() -- Deferred Script Context Connection Mode
    local script = { Parent = ui_instances.AutoFarmStorageToggle_3364, Name = "Function" }
    local TweenService = game:GetService("TweenService")
    local RunService = game:GetService("RunService")
    local Players = game:GetService("Players")
    
    local player = Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    
    local button = script.Parent
    local ind = button.Indicator
    
    local red = Color3.fromRGB(255, 0, 0)
    local green = Color3.fromRGB(0, 255, 0)
    
    local active = false
    
    --// Original character location
    local originalCFrame = nil
    
    --// Used to invalidate/abort old procedures
    local procedureId = 0
    
    --// Healing state
    local healing = false
    
    --// Connections that need cleaning
    local cameraConnection = nil
    local healthConnection = nil
    
    --// Animation
    local originalSize = button.Size
    
    local tweenInfoUp = TweenInfo.new(
    	0.08,
    	Enum.EasingStyle.Quad,
    	Enum.EasingDirection.Out
    )
    
    local tweenInfoDown = TweenInfo.new(
    	0.08,
    	Enum.EasingStyle.Quad,
    	Enum.EasingDirection.In
    )
    
    local biggerSize = UDim2.new(
    	originalSize.X.Scale,
    	originalSize.X.Offset + 6,
    	originalSize.Y.Scale,
    	originalSize.Y.Offset + 6
    )
    
    local currentTween = nil
    
    
    --//========================================================
    --// CHARACTER HELPERS
    --//========================================================
    
    local function getCharacter()
    	character = player.Character or player.CharacterAdded:Wait()
    
    	local humanoid = character:FindFirstChildOfClass("Humanoid")
    	local root = character:FindFirstChild("HumanoidRootPart")
    
    	if not humanoid or not root then
    		return nil, nil, nil
    	end
    
    	return character, humanoid, root
    end
    
    
    local function teleportTo(cframe)
    	local char, humanoid, root = getCharacter()
    
    	if not root then
    		return false
    	end
    
    	root.CFrame = cframe
    	return true
    end
    
    
    local function isProcedureValid(id)
    	return active and procedureId == id
    end
    
    
    --//========================================================
    --// CAMERA
    --//========================================================
    
    local function forceCameraLookAt(part)
    	if cameraConnection then
    		cameraConnection:Disconnect()
    		cameraConnection = nil
    	end
    
    	local camera = workspace.CurrentCamera
    
    	cameraConnection = RunService.RenderStepped:Connect(function()
    		if not active or not part or not part.Parent then
    			return
    		end
    
    		camera.CameraType = Enum.CameraType.Scriptable
    
    		-- Keep the camera where it currently is,
    		-- but force it to look directly at the target.
    		camera.CFrame = CFrame.lookAt(
    			camera.CFrame.Position,
    			part.Position
    		)
    	end)
    
    	-- Apply immediately too
    	camera.CameraType = Enum.CameraType.Scriptable
    	camera.CFrame = CFrame.lookAt(
    		camera.CFrame.Position,
    		part.Position
    	)
    end
    
    
    local function restoreCamera()
    	if cameraConnection then
    		cameraConnection:Disconnect()
    		cameraConnection = nil
    	end
    
    	local camera = workspace.CurrentCamera
    
    	camera.CameraType = Enum.CameraType.Custom
    
    	local char, humanoid = getCharacter()
    
    	if humanoid then
    		camera.CameraSubject = humanoid
    	end
    end
    
    
    --//========================================================
    --// HEALING
    --//========================================================
    
    local function startHealing(id)
    	if healing then
    		return
    	end
    
    	healing = true
    
    	local char, humanoid, root = getCharacter()
    
    	if not root or not humanoid then
    		return
    	end
    
    	-- Anchor immediately
    	root.Anchored = true
    
    	-- Teleport to healing location
    	root.CFrame = CFrame.new(-50, -15, -300)
    
    	-- Keep checking health
    	task.spawn(function()
    		while active and procedureId == id and healing do
    			local currentCharacter, currentHumanoid, currentRoot = getCharacter()
    
    			if not currentHumanoid or not currentRoot then
    				break
    			end
    
    			if currentHumanoid.Health >= 80 then
    				break
    			end
    
    			task.wait(0.05)
    		end
    
    		if not active or procedureId ~= id then
    			return
    		end
    
    		local currentCharacter, currentHumanoid, currentRoot = getCharacter()
    
    		if currentRoot then
    			currentRoot.Anchored = false
    		end
    
    		healing = false
    
    		-- Restarting is handled by the main procedure loop.
    	end)
    end
    
    
    --//========================================================
    --// HEALTH MONITOR
    --//========================================================
    
    local function setupHealthMonitor(id)
    	if healthConnection then
    		healthConnection:Disconnect()
    		healthConnection = nil
    	end
    
    	local char, humanoid = getCharacter()
    
    	if not humanoid then
    		return
    	end
    
    	healthConnection = humanoid.HealthChanged:Connect(function(health)
    		if not active or procedureId ~= id then
    			return
    		end
    
    		if health < 80 and not healing then
    			startHealing(id)
    		end
    	end)
    end
    
    
    --//========================================================
    --// STORAGE VALIDATION
    --//========================================================
    
    local function hasNearbyMob(storageModel)
    	local mobsFolder = workspace:FindFirstChild("Mobs")
    
    	if not mobsFolder then
    		return false
    	end
    
    	local storagePosition
    
    	if storageModel:IsA("Model") then
    		storagePosition = storageModel:GetPivot().Position
    	elseif storageModel:IsA("BasePart") then
    		storagePosition = storageModel.Position
    	else
    		return false
    	end
    
    	for _, mob in ipairs(mobsFolder:GetChildren()) do
    		if mob:IsA("Model") then
    			local mobRoot =
    				mob:FindFirstChild("HumanoidRootPart")
    				or mob.PrimaryPart
    
    			if mobRoot and (mobRoot.Position - storagePosition).Magnitude <= 35 then
    				return true
    			end
    		end
    	end
    
    	return false
    end
    
    
    local function isValidStorage(child)
    	if not child:IsA("Model") then
    		return false
    	end
    
    	-- Any Owner attribute means invalid,
    	-- regardless of its value.
    	if child:GetAttribute("Owner") ~= nil then
    		return false
    	end
    
    	-- Any Locked attribute means invalid.
    	if child:GetAttribute("Locked") ~= nil then
    		return false
    	end
    
    	-- Open must either not exist or be false.
    	if child:GetAttribute("Open") == true then
    		return false
    	end
    
    	-- Nearby mobs make it invalid.
    	if hasNearbyMob(child) then
    		return false
    	end
    
    	return true
    end
    
    
    local function getRandomValidStorage(id)
    	local storages = workspace:FindFirstChild("Storages")
    
    	if not storages then
    		return nil
    	end
    
    	local candidates = {}
    
    	for _, child in ipairs(storages:GetChildren()) do
    		if not isProcedureValid(id) then
    			return nil
    		end
    
    		if isValidStorage(child) then
    			table.insert(candidates, child)
    		end
    	end
    
    	if #candidates == 0 then
    		return nil
    	end
    
    	return candidates[math.random(1, #candidates)]
    end
    
    
    --//========================================================
    --// WAIT FOR STORAGE CHANGE
    --//========================================================
    
    local function waitForModelChange(model, id)
    	local changed = false
    	local connections = {}
    
    	local function trigger()
    		changed = true
    	end
    
    	-- Detect changes to the model itself
    	table.insert(
    		connections,
    		model.Changed:Connect(trigger)
    	)
    
    	-- Detect new things appearing anywhere inside it
    	table.insert(
    		connections,
    		model.DescendantAdded:Connect(trigger)
    	)
    
    	-- Detect things being removed
    	table.insert(
    		connections,
    		model.DescendantRemoving:Connect(trigger)
    	)
    
    	-- Detect property changes on everything currently inside
    	for _, descendant in ipairs(model:GetDescendants()) do
    		table.insert(
    			connections,
    			descendant.Changed:Connect(trigger)
    		)
    	end
    
    	while isProcedureValid(id) and not changed do
    		task.wait()
    	end
    
    	for _, connection in ipairs(connections) do
    		connection:Disconnect()
    	end
    
    	return isProcedureValid(id)
    end
    
    
    --//========================================================
    --// LOOT
    --//========================================================
    
    local function findPrompt(container)
    	if not container then
    		return nil
    	end
    
    	local prompt = container:FindFirstChildWhichIsA(
    		"ProximityPrompt",
    		true
    	)
    
    	return prompt
    end
    
    
    local function lootContents(storageModel, id)
    	local contents = storageModel:FindFirstChild("Contents")
    
    	if not contents then
    		return true
    	end
    
    	local mobs = contents:FindFirstChild("Mobs")
    
    	-- If mobs appeared, immediately abandon this storage.
    	if mobs then
    		return false
    	end
    
    	local loot = contents:FindFirstChild("Loot")
    
    	if not loot then
    		-- Wait one second, then check again.
    		local elapsed = 0
    
    		while elapsed < 1 do
    			if not isProcedureValid(id) then
    				return false
    			end
    
    			task.wait(0.05)
    			elapsed += 0.05
    		end
    
    		-- Check again
    		mobs = contents:FindFirstChild("Mobs")
    
    		if mobs then
    			return false
    		end
    
    		loot = contents:FindFirstChild("Loot")
    
    		if not loot then
    			return true
    		end
    	end
    
    	-- Loot every child
    	for _, lootItem in ipairs(loot:GetChildren()) do
    		if not isProcedureValid(id) then
    			return false
    		end
    
    		-- Check health before each item
    		local _, humanoid = getCharacter()
    
    		if humanoid and humanoid.Health < 80 then
    			return false
    		end
    
    		local _, _, root = getCharacter()
    
    		if not root then
    			return false
    		end
    
    		-- Teleport to the loot item
    		local lootPart
    
    		if lootItem:IsA("BasePart") then
    			lootPart = lootItem
    		elseif lootItem:IsA("Model") then
    			lootPart =
    				lootItem.PrimaryPart
    				or lootItem:FindFirstChildWhichIsA("BasePart", true)
    		end
    
    		if lootPart then
    			root.CFrame = lootPart.CFrame
    
    			-- Force camera to look at loot
    			forceCameraLookAt(lootPart)
    
    			local prompt = findPrompt(lootItem)
    
    			if prompt then
    				-- Executor-only function.
    				if typeof(fireproximityprompt) == "function" then
    					fireproximityprompt(prompt)
    				end
    			end
    		end
    
    		task.wait()
    	end
    
    	return true
    end
    
    
    --//========================================================
    --// ONE STORAGE RUN
    --//========================================================
    
    local function processStorage(storageModel, id)
    	if not isProcedureValid(id) then
    		return false
    	end
    
    	local door = storageModel:FindFirstChild("Door")
    
    	if not door then
    		return false
    	end
    
    	local cube = door:FindFirstChild("Cube.001")
    	local handle = door:FindFirstChild("Handle")
    
    	if not cube or not cube:IsA("BasePart") then
    		return false
    	end
    
    	if not handle or not handle:IsA("BasePart") then
    		return false
    	end
    
    	--// Teleport 5 studs backwards on the door part's local axis.
    	--// Change +5 to -5 if your door faces the opposite direction.
    	local startingCFrame =
    		cube.CFrame * CFrame.new(0, 0, 5)
    
    	if not teleportTo(startingCFrame) then
    		return false
    	end
    
    	-- Wait 3 seconds
    	for _ = 1, 30 do
    		if not isProcedureValid(id) then
    			return false
    		end
    
    		task.wait(0.1)
    	end
    
    	-- Tween character to Handle
    	local _, humanoid, root = getCharacter()
    
    	if not root or not humanoid then
    		return false
    	end
    
    	local tween = TweenService:Create(
    		root,
    		TweenInfo.new(
    			1,
    			Enum.EasingStyle.Linear,
    			Enum.EasingDirection.InOut
    		),
    		{
    			CFrame = handle.CFrame
    		}
    	)
    
    	tween:Play()
    
    	-- Don't allow toggle-off to leave us waiting for a tween.
    	while tween.PlaybackState == Enum.PlaybackState.Playing do
    		if not isProcedureValid(id) then
    			tween:Cancel()
    			return false
    		end
    
    		task.wait()
    	end
    
    	if not isProcedureValid(id) then
    		return false
    	end
    
    	-- Force camera to look at Handle
    	forceCameraLookAt(handle)
    
    	-- Find the ProximityPrompt somewhere inside Handle
    	local prompt = findPrompt(handle)
    
    	if prompt and typeof(fireproximityprompt) == "function" then
    		fireproximityprompt(prompt)
    	end
    
    	-- Immediately wait for ANY change/addition/removal
    	if not waitForModelChange(storageModel, id) then
    		return false
    	end
    
    	if not isProcedureValid(id) then
    		return false
    	end
    
    	-- Check for Mobs FIRST
    	local contents = storageModel:FindFirstChild("Contents")
    
    	if contents then
    		local mobs = contents:FindFirstChild("Mobs")
    
    		if mobs then
    			-- Mob appeared.
    			-- Abandon this storage immediately.
    			return false
    		end
    	end
    
    	-- No mobs, so process loot.
    	local lootFinished = lootContents(storageModel, id)
    
    	return lootFinished
    end
    
    
    --//========================================================
    --// CLEANUP
    --//========================================================
    
    local function cleanup(restorePosition)
    	local char, humanoid, root = getCharacter()
    
    	if root then
    		root.Anchored = false
    	end
    
    	healing = false
    
    	restoreCamera()
    
    	if restorePosition and originalCFrame then
    		local _, _, currentRoot = getCharacter()
    
    		if currentRoot then
    			currentRoot.CFrame = originalCFrame
    		end
    	end
    
    	if healthConnection then
    		healthConnection:Disconnect()
    		healthConnection = nil
    	end
    end
    
    
    --//========================================================
    --// MAIN PROCEDURE
    --//========================================================
    
    local function runProcedure(id)
    	local char, humanoid, root = getCharacter()
    
    	if not char or not humanoid or not root then
    		return
    	end
    
    	-- Save the exact original CFrame.
    	originalCFrame = root.CFrame
    
    	setupHealthMonitor(id)
    
    	while isProcedureValid(id) do
    
    		--==================================================
    		-- HEALTH / HEALING
    		--==================================================
    
    		if humanoid.Health < 80 or healing then
    			if not healing then
    				startHealing(id)
    			end
    
    			-- Stay here until healing finishes or toggle is turned off.
    			while isProcedureValid(id) and healing do
    				task.wait(0.05)
    			end
    
    			if not isProcedureValid(id) then
    				break
    			end
    
    			-- Health is >= 80 now.
    			-- Find another storage and continue.
    		end
    
    		--==================================================
    		-- FIND RANDOM VALID STORAGE
    		--==================================================
    
    		local storage = getRandomValidStorage(id)
    
    		if not storage then
    			-- Nothing valid right now.
    			task.wait(0.25)
    			continue
    		end
    
    		--==================================================
    		-- PROCESS STORAGE
    		--==================================================
    
    		local success = processStorage(storage, id)
    
    		if not isProcedureValid(id) then
    			break
    		end
    
    		-- If Mobs appeared, processStorage returns false.
    		-- Simply choose another storage and start again.
    		if not success then
    			task.wait()
    			continue
    		end
    
    		-- Successful loot procedure.
    		-- Go find another storage and continue.
    		task.wait()
    	end
    end
    
    
    --//========================================================
    --// TOGGLE
    --//========================================================
    
    button.Activated:Connect(function()
    
    	-- Toggle state
    	active = not active
    
    	if active then
    		ind.BackgroundColor3 = green
    	else
    		ind.BackgroundColor3 = red
    	end
    
    	-- Stop current button animation
    	if currentTween then
    		currentTween:Cancel()
    	end
    
    	button.Size = originalSize
    
    	currentTween = TweenService:Create(
    		button,
    		tweenInfoUp,
    		{
    			Size = biggerSize
    		}
    	)
    
    	currentTween:Play()
    
    	currentTween.Completed:Connect(function()
    		if not button.Parent then
    			return
    		end
    
    		currentTween = TweenService:Create(
    			button,
    			tweenInfoDown,
    			{
    				Size = originalSize
    			}
    		)
    
    		currentTween:Play()
    	end)
    
    	--======================================================
    	-- TURN ON
    	--======================================================
    
    	if active then
    
    		-- Invalidate any previous procedure
    		procedureId += 1
    
    		local thisProcedure = procedureId
    
    		task.spawn(function()
    			runProcedure(thisProcedure)
    		end)
    
    		--======================================================
    		-- TURN OFF
    		--======================================================
    
    	else
    
    		-- This instantly invalidates every running loop.
    		procedureId += 1
    
    		-- Cleanup and return to the original location.
    		cleanup(true)
    	end
    end)
end)

task.spawn(function() -- Deferred Script Context Connection Mode
    local script = { Parent = ui_instances.AutoFarmBasementToggle_8072, Name = "highlight2" }
    local INTENSITY = 10
    local FADE_SPEED = 10
    local LAG_SPEED = 20
    local SPREAD_SOFTNESS = 0.7 
    
    local rs = game:GetService("RunService")
    local plrs = game:GetService("Players")
    local ui = script.Parent
    local p = plrs.LocalPlayer
    local m = p:GetMouse() -- Used for coordinate consistency
    
    local pct = math.clamp(INTENSITY / 10, 0, 1)
    
    local grad = Instance.new("UIGradient")
    grad.Rotation = 45 
    grad.Enabled = false 
    grad.Parent = ui
    
    local prg = 0 
    local currentOffset = Vector2.new(0, 0)
    
    rs.RenderStepped:Connect(function(dt)
    	if not ui.Visible then return end
    
    	local h = false
    	local pos = ui.AbsolutePosition
    	local size = ui.AbsoluteSize
    
    	-- Pixel-perfect boundaries using PlayerMouse coordinates
    	if m.X >= pos.X and m.X <= (pos.X + size.X) and m.Y >= pos.Y and m.Y <= (pos.Y + size.Y) then
    		h = true
    	end
    
    	local wasIdle = (prg == 0)
    	prg = math.clamp(prg + (dt * FADE_SPEED * (h and 1 or -1)), 0, 1)
    
    	if wasIdle and prg == 0 then
    		if grad.Enabled then grad.Enabled = false end
    		return
    	end
    
    	if wasIdle and prg > 0 then
    		grad.Enabled = true
    	end
    
    	-- LIVE READ: Reads the base color live
    	local oc = ui.BackgroundColor3
    	local hc = Color3.new(
    		math.clamp(oc.R + (1 - oc.R) * pct, 0, 1),
    		math.clamp(oc.G + (1 - oc.G) * pct, 0, 1),
    		math.clamp(oc.B + (1 - oc.B) * pct, 0, 1)
    	)
    
    	-- 1. Calculate mouse position relative to the element (using pixel-perfect coordinates)
    	local scaleX = size.X > 0 and math.clamp((m.X - pos.X) / size.X, 0, 1) or 0.5
    	local scaleY = size.Y > 0 and math.clamp((m.Y - pos.Y) / size.Y, 0, 1) or 0.5
    
    	-- 2. Shift the center...
    	local targetOffset = Vector2.new(scaleX - 0.5, scaleY - 0.5)
    
    	-- 3. Apply drag/lag...
    	currentOffset = currentOffset:Lerp(targetOffset, math.clamp(dt * LAG_SPEED, 0, 1))
    	grad.Offset = currentOffset
    
    	-- 4. Blend the gradient's center color dynamically
    	local currentMidColor = oc:Lerp(hc, prg)
    
    	-- 5. Calculate expanded spread colors
    	local spreadColor = oc:Lerp(currentMidColor, SPREAD_SOFTNESS)
    
    	-- 6. Apply the sequence
    	grad.Color = ColorSequence.new({
    		ColorSequenceKeypoint.new(0, oc),                       
    		ColorSequenceKeypoint.new(0.2, spreadColor),            
    		ColorSequenceKeypoint.new(0.5, currentMidColor),        
    		ColorSequenceKeypoint.new(0.8, spreadColor),            
    		ColorSequenceKeypoint.new(1, oc)                        
    	})
    end)
end)

task.spawn(function() -- Deferred Script Context Connection Mode

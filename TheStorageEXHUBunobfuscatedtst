    	textLabel.Size = UDim2.new(1, 0, 1, 0)
    	textLabel.BackgroundTransparency = 1
    	textLabel.FontFace.Weight = Enum.FontWeight.Bold
    	textLabel.Text = lootItem.Name
    	textLabel.TextColor3 = yellow
    	textLabel.TextScaled = true
    	textLabel.TextStrokeTransparency = 0
    	textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    	textLabel.Parent = billboard
    
    	billboard.Parent = lootItem
    	table.insert(visuals, billboard)
    
    	activeLootVisuals[lootItem] = visuals
    end
    
    -- Destroys visuals
    local function removeLootVisuals(lootItem)
    	if activeLootVisuals[lootItem] then
    		for _, instance in ipairs(activeLootVisuals[lootItem]) do
    			if instance and instance.Parent then
    				instance:Destroy()
    			end
    		end
    		activeLootVisuals[lootItem] = nil
    	end
    end
    
    -- Central tracking logic running on every frame
    local function scanLootProximity()
    	local character = localPlayer.Character
    	if not character then return end
    
    	local rootPart = character:FindFirstChild("HumanoidRootPart")
    	if not rootPart then return end
    
    	local characterPosition = rootPart.Position
    	local currentLootRegistry = {}
    	local allTrackedItems = {}
    
    	-- Combine items from ANY folder named "Loot"
    	for folder, _ in pairs(lootFoldersRegistry) do
    		for _, item in ipairs(folder:GetChildren()) do
    			table.insert(allTrackedItems, item)
    		end
    	end
    
    	-- Add loose workspace tools
    	for toolItem, _ in pairs(workspaceToolsRegistry) do
    		table.insert(allTrackedItems, toolItem)
    	end
    
    	-- Process targets
    	for _, lootItem in ipairs(allTrackedItems) do
    		-- Ensure item is still valid (in a Loot folder or Workspace)
    		if (lootItem.Parent and lootItem.Parent.Name == "Loot") or lootItem.Parent == workspace then
    			local physicalPart = getLootPhysicalPart(lootItem)
    
    			if physicalPart then
    				currentLootRegistry[lootItem] = true
    				local distance = (physicalPart.Position - characterPosition).Magnitude
    
    				if distance <= 65 then
    					if not activeLootVisuals[lootItem] then
    						createLootVisuals(lootItem, physicalPart)
    					end
    				else
    					if activeLootVisuals[lootItem] then
    						removeLootVisuals(lootItem)
    					end
    				end
    			end
    		end
    	end
    
    	-- Anti-Desync: Destroy visual tracks for items pulled, equipped, or deleted
    	for trackedLoot, _ in pairs(activeLootVisuals) do
    		local isValidParent = trackedLoot.Parent and (trackedLoot.Parent.Name == "Loot" or trackedLoot.Parent == workspace)
    		if not currentLootRegistry[trackedLoot] or not isValidParent then
    			removeLootVisuals(trackedLoot)
    		end
    	end
    end
    
    -- Folder & Tool indexing helpers
    local function registerIfLootFolder(obj)
    	if obj:IsA("Folder") and obj.Name == "Loot" then
    		lootFoldersRegistry[obj] = true
    	end
    end
    
    local function unregisterIfLootFolder(obj)
    	if lootFoldersRegistry[obj] then
    		lootFoldersRegistry[obj] = nil
    	end
    end
    
    local function checkAndRegisterTool(child)
    	if child:IsA("Tool") then
    		workspaceToolsRegistry[child] = true
    	end
    end
    
    local function unregisterTool(child)
    	if workspaceToolsRegistry[child] then
    		workspaceToolsRegistry[child] = nil
    		removeLootVisuals(child)
    	end
    end
    
    local function enableLootSystem()
    	-- 1. Scan for existing Loot folders and loose tools
    	for _, obj in ipairs(workspace:GetDescendants()) do
    		registerIfLootFolder(obj)
    		if obj.Parent == workspace then
    			checkAndRegisterTool(obj)
    		end
    	end
    
    	-- 2. Watch for new folders or tools dynamically
    	descendantAddedConn = workspace.DescendantAdded:Connect(registerIfLootFolder)
    	descendantRemovingConn = workspace.DescendantRemoving:Connect(unregisterIfLootFolder)
    
    	workspaceAddedConn = workspace.ChildAdded:Connect(checkAndRegisterTool)
    	workspaceRemovedConn = workspace.ChildRemoved:Connect(unregisterTool)
    
    	-- 3. Connect to Heartbeat
    	proximityLoopConn = RunService.Heartbeat:Connect(scanLootProximity)
    end
    
    local function disableLootSystem()
    	if proximityLoopConn then proximityLoopConn:Disconnect(); proximityLoopConn = nil end
    	if workspaceAddedConn then workspaceAddedConn:Disconnect(); workspaceAddedConn = nil end
    	if workspaceRemovedConn then workspaceRemovedConn:Disconnect(); workspaceRemovedConn = nil end
    	if descendantAddedConn then descendantAddedConn:Disconnect(); descendantAddedConn = nil end
    	if descendantRemovingConn then descendantRemovingConn:Disconnect(); descendantRemovingConn = nil end
    
    	for lootItem, _ in pairs(activeLootVisuals) do
    		removeLootVisuals(lootItem)
    	end
    
    	table.clear(workspaceToolsRegistry)
    	table.clear(lootFoldersRegistry)
    end
    
    -- Button Activator Event
    script.Parent.Activated:Connect(function()
    	active = not active
    
    	if active then
    		ind.BackgroundColor3 = green
    		enableLootSystem()
    	else
    		ind.BackgroundColor3 = red
    		disableLootSystem()
    	end
    
    	if currentTween then
    		currentTween:Cancel()
    	end
    
    	script.Parent.Size = originalSize
    	currentTween = TweenService:Create(
    		script.Parent,
    		tweenInfoUp,
    		{Size = biggerSize}
    	)
    	currentTween:Play()
    
    	currentTween.Completed:Wait()
    
    	currentTween = TweenService:Create(
    		script.Parent,
    		tweenInfoDown,
    		{Size = originalSize}
    	)
    	currentTween:Play()
    end)
end)


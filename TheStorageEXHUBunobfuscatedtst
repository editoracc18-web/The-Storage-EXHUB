    local savedMinZoom = 0.5
    local savedMaxZoom = 100
    
    -- Key combo tracking states
    local pressedG = false
    local pressedH = false
    
    local function doo()
    	active = not active
    	if active then 
    		if ind then ind.BackgroundColor3 = green end
    		-- Save current state before overriding
    		savedCameraMode = player.CameraMode
    		savedMinZoom = player.CameraMinZoomDistance
    		savedMaxZoom = player.CameraMaxZoomDistance
    	else 
    		if ind then ind.BackgroundColor3 = red end
    		-- Restore previous state
    		player.CameraMode = savedCameraMode
    		player.CameraMinZoomDistance = savedMinZoom
    		player.CameraMaxZoomDistance = savedMaxZoom
    	end
    
    	-- Stop active animation so spamming works safely
    	if currentTween then
    		currentTween:Cancel()
    	end
    
    	script.Parent.Size = originalSize
    	currentTween = TweenService:Create(script.Parent, tweenInfoUp, {Size = biggerSize})
    	currentTween:Play()
    	currentTween.Completed:Wait()
    	currentTween = TweenService:Create(script.Parent, tweenInfoDown, {Size = originalSize})
    	currentTween:Play()
    end
    

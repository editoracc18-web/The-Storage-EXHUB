task.spawn(function()
    local script = { Parent = obj_Golden_Skull_5773, Name = "switcher" }
    local bt = script.Parent
    local fol = bt.Parent
    local box = bt.Parent.Parent.Parent.Items
    bt:SetAttribute("Selected", false)
    local cached = 0
    local name = ""
    bt.Activated:Connect(function()
    	cached = 0
    	name = ""
    	if bt:GetAttribute("Selected") then
    		bt:SetAttribute("Selected", false)
    		bt.BackgroundTransparency = 1
    		for _, i in ipairs(fol:GetChildren()) do
    			if i:IsA("TextButton") then
    				if i:GetAttribute("Selected") then
    					name = i.Name
    					if cached >= 2 then
    						box.Text = i.Name..", ..."
    					end
    					cached = cached +1
    				else
    					continue
    				end
    			end
    		end
    		if cached < 2 then
    			cached = 0
    			box.Text = name
    		end
    		name = ""
    	else
    		bt:SetAttribute("Selected", true)
    		bt.BackgroundTransparency = 0
    		if box.Text == "" then
    			box.Text = bt.Name
    		else
    			box.Text = bt.Name..", ..."
    		end
    	end
    end)
end)

task.spawn(function() -- Deferred Script Context Connection Mode
    local script = { Parent = ui_instances.BasementMiniMap_9134, Name = "Mapper" }
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    
    local localPlayer = Players.LocalPlayer
    
    local miniMap = script.Parent
    local map = miniMap:WaitForChild("Map")
    
    local plrIcon = map:WaitForChild("Plr")
    local otherPlayerTemplate = map:WaitForChild("OPlr")
    local mobTemplate = map:WaitForChild("MPlr")
    
    local mobsFolder = workspace:WaitForChild("Mobs")
    
    local MIN_X = -760
    local MAX_X = 760
    local MIN_Z = -255
    local MAX_Z = 255
    
    local WIDTH = MAX_X - MIN_X
    local DEPTH = MAX_Z - MIN_Z
    
    local TRACK_BELOW_Y = -20
    
    local playerIcons = {}
    local mobIcons = {}
    
    local function worldToMap(position)
    	local xPercent = (position.X - MIN_X) / WIDTH
    	local yPercent = (position.Z - MIN_Z) / DEPTH
    
    	xPercent = math.clamp(xPercent, 0, 1)
    	yPercent = math.clamp(yPercent, 0, 1)
    
    	return xPercent, yPercent
    end
    
    local function setIconPosition(icon, position)
    	local xPercent, yPercent = worldToMap(position)
    	icon.Position = UDim2.fromScale(xPercent, yPercent)
    end
    
    local function getRoot(model)
    	if not model then
    		return nil
    	end
    
    	if model:IsA("Model") then
    		return model:FindFirstChild("HumanoidRootPart")
    			or model.PrimaryPart
    			or model:FindFirstChildWhichIsA("BasePart")
    	end
    
    	if model:IsA("BasePart") then
    		return model
    	end
    
    	return nil
    end
    
    local function setArrowRotation(icon, root)
    	local look = root.CFrame.LookVector
    
    	-- Arrow points in the correct world direction.
    	-- -look.X fixes the left/right mirroring.
    	-- +180 accounts for the arrow image's default orientation.
    	icon.Rotation = math.deg(math.atan2(-look.X, look.Z)) + 180
    end
    
    -- LOCAL PLAYER
    
    local function updateLocalPlayer()
    	local character = localPlayer.Character
    	local root = getRoot(character)
    
    	if not root then
    		plrIcon.Visible = false
    		return
    	end
    
    	if root.Position.Y >= TRACK_BELOW_Y then
    		plrIcon.Visible = false
    		return
    	end
    
    	setIconPosition(plrIcon, root.Position)
    	setArrowRotation(plrIcon, root)
    
    	plrIcon.Visible = true
    end
    
    -- OTHER PLAYERS
    
    local function createPlayerIcon(player)
    	if player == localPlayer then
    		return
    	end
    
    	if playerIcons[player] then
    		return
    	end
    
    	local icon = otherPlayerTemplate:Clone()
    
    	icon.Name = "Player_" .. player.UserId
    	icon.Visible = false
    	icon.Parent = map
    
    	playerIcons[player] = icon
    end
    
    local function removePlayerIcon(player)
    	local icon = playerIcons[player]
    
    	if icon then
    		icon:Destroy()
    		playerIcons[player] = nil
    	end
    end
    
    local function updateOtherPlayers()
    	for player, icon in pairs(playerIcons) do
    		local character = player.Character
    		local root = getRoot(character)
    
    		if not root then
    			icon.Visible = false
    			continue
    		end
    
    		if root.Position.Y >= TRACK_BELOW_Y then
    			icon.Visible = false
    			continue
    		end
    
    		setIconPosition(icon, root.Position)
    		setArrowRotation(icon, root)
    
    		icon.Visible = true
    	end
    end
    
    -- MOBS
    
    local function createMobIcon(mob)
    	if mobIcons[mob] then
    		return
    	end
    
    	local icon = mobTemplate:Clone()
    
    	icon.Name = "Mob_" .. mob.Name
    	icon.Visible = false
    	icon.Parent = map
    
    	mobIcons[mob] = icon
    end
    
    local function removeMobIcon(mob)
    	local icon = mobIcons[mob]
    
    	if icon then
    		icon:Destroy()
    		mobIcons[mob] = nil
    	end
    end
    
    local function updateMobs()
    	for mob, icon in pairs(mobIcons) do
    		if not mob.Parent then
    			removeMobIcon(mob)
    			continue
    		end
    
    		local root = getRoot(mob)
    
    		if not root then
    			icon.Visible = false
    			continue
    		end
    
    		if root.Position.Y >= TRACK_BELOW_Y then
    			icon.Visible = false
    			continue
    		end
    
    		setIconPosition(icon, root.Position)
    		setArrowRotation(icon, root)
    
    		icon.Visible = true
    	end
    end
    
    -- PLAYER SETUP
    
    for _, player in ipairs(Players:GetPlayers()) do
    	createPlayerIcon(player)
    end
    
    Players.PlayerAdded:Connect(createPlayerIcon)
    Players.PlayerRemoving:Connect(removePlayerIcon)
    
    -- MOB SETUP
    
    for _, mob in ipairs(mobsFolder:GetChildren()) do
    	createMobIcon(mob)
    end
    
    mobsFolder.ChildAdded:Connect(createMobIcon)
    mobsFolder.ChildRemoved:Connect(removeMobIcon)
    
    -- UPDATE
    
    RunService.RenderStepped:Connect(function()
    	if not miniMap.Visible then
    		return
    	end
    
    	updateLocalPlayer()
    	updateOtherPlayers()
    	updateMobs()
    end)
end)


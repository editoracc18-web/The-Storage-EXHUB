    	local size = ui.AbsoluteSize
    
    	-- Pixel-perfect boundaries using PlayerMouse coordinates
    	if m.X >= pos.X and m.X <= (pos.X + size.X) and m.Y >= pos.Y and m.Y <= (pos.Y + size.Y) then
    		h = true
    	end
    
    	local wasIdle = (prg == 0)
    	prg = math.clamp(prg + (dt * FADE_SPEED * (h and 1 or -1)), 0, 1)
    
    	if wasIdle and prg == 0 then
    		if grad.Enabled then grad.Enabled = false end
    		return
    	end
    
    	if wasIdle and prg > 0 then
    		grad.Enabled = true
    	end
    
    	-- LIVE READ: Reads the base color live
    	local oc = ui.BackgroundColor3
    	local hc = Color3.new(
    		math.clamp(oc.R + (1 - oc.R) * pct, 0, 1),
    		math.clamp(oc.G + (1 - oc.G) * pct, 0, 1),
    		math.clamp(oc.B + (1 - oc.B) * pct, 0, 1)
    	)
    
    	-- 1. Calculate mouse position relative to the element (using pixel-perfect coordinates)
    	local scaleX = size.X > 0 and math.clamp((m.X - pos.X) / size.X, 0, 1) or 0.5
    	local scaleY = size.Y > 0 and math.clamp((m.Y - pos.Y) / size.Y, 0, 1) or 0.5
    
    	-- 2. Shift the center...
    	local targetOffset = Vector2.new(scaleX - 0.5, scaleY - 0.5)
    
    	-- 3. Apply drag/lag...
    	currentOffset = currentOffset:Lerp(targetOffset, math.clamp(dt * LAG_SPEED, 0, 1))
    	grad.Offset = currentOffset
    
    	-- 4. Blend the gradient's center color dynamically
    	local currentMidColor = oc:Lerp(hc, prg)
    
    	-- 5. Calculate expanded spread colors
    	local spreadColor = oc:Lerp(currentMidColor, SPREAD_SOFTNESS)
    
    	-- 6. Apply the sequence
    	grad.Color = ColorSequence.new({
    		ColorSequenceKeypoint.new(0, oc),                       
    		ColorSequenceKeypoint.new(0.2, spreadColor),            
    		ColorSequenceKeypoint.new(0.5, currentMidColor),        
    		ColorSequenceKeypoint.new(0.8, spreadColor),            
    		ColorSequenceKeypoint.new(1, oc)                        
    	})
    end)
end)

task.spawn(function() -- Deferred Script Context Connection Mode
    local script = { Parent = ui_instances.AutoFarmStorageToggle_4473, Name = "Function" }
    local TweenService = game:GetService("TweenService")
    local RunService = game:GetService("RunService")
    local Players = game:GetService("Players")
    
    local player = Players.LocalPlayer
    
    local button = script.Parent
    local ind = button.Indicator
    
    local red = Color3.fromRGB(255, 0, 0)
    local green = Color3.fromRGB(0, 255, 0)
    
    local active = false
    local healing = false
    
    local procedureId = 0
    local originalCFrame = nil
    
    local cameraConnection = nil
    local healthConnection = nil
    
    --========================================================
    -- BUTTON ANIMATION
    --========================================================
    
    local originalSize = button.Size
    
    local tweenInfoUp = TweenInfo.new(
    	0.08,
    	Enum.EasingStyle.Quad,
    	Enum.EasingDirection.Out
    )
    
    local tweenInfoDown = TweenInfo.new(
    	0.08,
    	Enum.EasingStyle.Quad,
    	Enum.EasingDirection.In
    )
    
    local biggerSize = UDim2.new(
    	originalSize.X.Scale,
    	originalSize.X.Offset + 6,
    	originalSize.Y.Scale,
    	originalSize.Y.Offset + 6
    )
    
    local currentTween = nil
    
    
    --========================================================
    -- CHARACTER
    --========================================================
    
    local function getCharacter()
    	local character = player.Character
    
    	if not character then
    		return nil, nil, nil
    	end
    
    	local humanoid = character:FindFirstChildOfClass("Humanoid")
    	local root = character:FindFirstChild("HumanoidRootPart")
    
    	return character, humanoid, root
    end
    
    
    local function teleportTo(cframe)
    	local _, _, root = getCharacter()
    
    	if not root then
    		return false
    	end
    
    	root.CFrame = cframe
    
    	return true
    end
    
    
    local function isProcedureValid(id)
    	return active and procedureId == id
    end
    
    
    --========================================================
    -- CAMERA
    --========================================================
    
    local function forceCameraLookAt(part)
    
    	if cameraConnection then
    		cameraConnection:Disconnect()
    		cameraConnection = nil
    	end
    
    	if not part or not part.Parent then
    		return
    	end
    
    	local camera = workspace.CurrentCamera
    
    	camera.CameraType = Enum.CameraType.Scriptable
    
    	cameraConnection = RunService.RenderStepped:Connect(function()
    
    		if not active then
    			return
    		end
    
    		if not part or not part.Parent then
    			return
    		end
    
    		camera.CFrame = CFrame.lookAt(
    			camera.CFrame.Position,
    			part.Position
    		)
    	end)
    
    	camera.CFrame = CFrame.lookAt(
    		camera.CFrame.Position,
    		part.Position
    	)
    end
    
    
    local function restoreCamera()
    
    	if cameraConnection then
    		cameraConnection:Disconnect()
    		cameraConnection = nil
    	end
    
    	local camera = workspace.CurrentCamera
    
    	camera.CameraType = Enum.CameraType.Custom
    
    	local _, humanoid = getCharacter()
    
    	if humanoid then
    		camera.CameraSubject = humanoid
    	end
    end
    
    
    --========================================================
    -- HEALING
    --========================================================
    
    local function startHealing(id)
    
    	if healing then
    		return
    	end
    
    	healing = true
    
    	local _, humanoid, root = getCharacter()
    
    	if not humanoid or not root then
    		healing = false
    		return
    	end
    
    	-- Stop camera lock
    	restoreCamera()
    
    	-- Healing location
    	local healingCenter = Vector3.new(
    		-200,
    		150,
    		-300
    	)
    
    	local radius = 12
    	local circleSpeed = 1.5
    
    	-- Anchor
    	root.Anchored = true
    
    	-- Immediately move away
    	root.CFrame = CFrame.new(
    		healingCenter
    			+ Vector3.new(
    				radius,
    				0,
    				0
    			)
    	)
    
    	task.spawn(function()
    
    		local angle = 0
    
    		while active
    			and procedureId == id
    			and healing do
    
    			local _, currentHumanoid, currentRoot =
    				getCharacter()
    
    			if not currentHumanoid or not currentRoot then
    				break
    			end
    
    			if currentHumanoid.Health >= 80 then
    				break
    			end
    
    			angle += math.rad(90)
    
    			local targetPosition =
    				healingCenter
    				+ Vector3.new(
    					math.cos(angle) * radius,
    					0,
    					math.sin(angle) * radius
    				)
    
    			local targetCFrame =
    				CFrame.lookAt(
    					targetPosition,
    					healingCenter
    				)
    
    			local tween =
    				TweenService:Create(
    					currentRoot,
    
    					TweenInfo.new(
    						circleSpeed,
    						Enum.EasingStyle.Linear
    					),
    
    					{
    						CFrame = targetCFrame
    					}
    				)
    
    			tween:Play()
    
    			while tween.PlaybackState ==
    				Enum.PlaybackState.Playing do
    
    				if not active
    					or procedureId ~= id then
    
    					tween:Cancel()
    					return
    				end
    
    				local _, checkHumanoid =
    					getCharacter()
    
    				if not checkHumanoid then
    					tween:Cancel()
    					return
    				end
    
    				if checkHumanoid.Health >= 80 then
    					tween:Cancel()
    					break
    				end
    
    				task.wait(0.03)
    			end
    		end
    
    		if not active
    			or procedureId ~= id then
    
    			return
    		end
    
    		local _, currentHumanoid, currentRoot =
    			getCharacter()
    
    		if currentRoot then
    			currentRoot.Anchored = false
    		end
    
    		healing = false
    	end)
    end
    
    
    --========================================================
    -- HEALTH
    --========================================================
    
    local function setupHealthMonitor(id)
    
    	if healthConnection then
    		healthConnection:Disconnect()
    		healthConnection = nil
    	end
    
    	local _, humanoid = getCharacter()
    
    	if not humanoid then
    		return
    	end
    
    	healthConnection =
    		humanoid.HealthChanged:Connect(function(health)
    
    			if not isProcedureValid(id) then
    				return
    			end
    
    			if health < 80 and not healing then
    				startHealing(id)
    			end
    		end)
    end
    
    
    local function shouldAbort(id)
    
    	if not isProcedureValid(id) then
    		return true
    	end
    
    	local _, humanoid = getCharacter()
    
    	if not humanoid then
    		return true
    	end
    
    	if humanoid.Health < 80 then
    
    		if not healing then
    			startHealing(id)
    		end
    
    		return true
    	end
    
    	return false
    end
    
    
    --========================================================
    -- WAIT
    --========================================================
    
    local function smartWait(seconds, id)
    
    	local elapsed = 0
    
    	while elapsed < seconds do
    
    		if shouldAbort(id) then
    			return false
    		end
    
    		task.wait(0.03)
    
    		elapsed += 0.03
    	end
    
    	return true
    end
    
    
    --========================================================
    -- NEARBY MOB CHECK
    --========================================================
    
    local function hasNearbyMob(storageModel)
    
    	local mobsFolder =
    		workspace:FindFirstChild("Mobs")
    
    	if not mobsFolder then
    		return false
    	end
    
    	local storagePosition
    
    	if storageModel:IsA("Model") then
    
    		storagePosition =
    			storageModel:GetPivot().Position
    
    	elseif storageModel:IsA("BasePart") then
    
    		storagePosition =
    			storageModel.Position
    
    	else
    
    		return false
    	end
    
    	for _, mob in ipairs(
    		mobsFolder:GetChildren()
    		) do
    
    		if mob:IsA("Model") then
    
    			local mobRoot =
    				mob:FindFirstChild("HumanoidRootPart")
    				or mob.PrimaryPart
    
    			if mobRoot then
    
    				if
    					(mobRoot.Position - storagePosition).Magnitude
    					<= 35
    				then
    
    					return true
    				end
    			end
    		end
    	end
    
    	return false
    end
    
    
    --========================================================
    -- STORAGE VALIDATION
    --========================================================
    
    local function isValidStorage(storage)
    
    	if not storage:IsA("Model") then
    		return false
    	end
    
    	-- Owner existing = invalid
    	if storage:GetAttribute("Owner") ~= nil then
    		return false
    	end
    
    	-- Locked existing = invalid
    	if storage:GetAttribute("Locked") ~= nil then
    		return false
    	end
    
    	-- Open true = invalid
    	if storage:GetAttribute("Open") == true then
    		return false
    	end
    
    	-- Mob within 35 studs = invalid
    	if hasNearbyMob(storage) then
    		return false
    	end
    
    	return true
    end
    
    
    local function getRandomValidStorage(id)
    
    	local storages =
    		workspace:FindFirstChild("Storages")
    
    	if not storages then
    		return nil
    	end
    
    	local valid = {}
    
    	for _, child in ipairs(
    		storages:GetChildren()
    		) do
    
    		if not isProcedureValid(id) then
    			return nil
    		end
    
    		if isValidStorage(child) then
    			table.insert(valid, child)
    		end
    	end
    
    	if #valid == 0 then
    		return nil
    	end
    
    	return valid[
    	math.random(1, #valid)
    	]
    end
    
    
    --========================================================
    -- PROXIMITY PROMPT
    --========================================================
    
    local function findPrompt(container)
    
    	if not container then
    		return nil
    	end
    
    	return container:FindFirstChildWhichIsA(
    		"ProximityPrompt",
    		true
    	)
    end
    
    
    local function firePrompt(prompt)
    
    	if not prompt then
    		return
    	end
    
    	if typeof(fireproximityprompt) == "function" then
    		fireproximityprompt(prompt)
    	end
    end
    
    
    --========================================================
    -- LOOT
    --========================================================
    
    local function processLoot(storage, id)
    
    	local contents =
    		storage:FindFirstChild("Contents")
    
    	if not contents then
    		return
    	end
    
    	local loot =
    		contents:FindFirstChild("Loot")
    
    	if not loot then
    		return
    	end
    
    	-- Required 0.2 second wait
    	if not smartWait(0.2, id) then
    		return
    	end
    
    	--======================================================
    	-- KEEP PROCESSING UNTIL LOOT IS EMPTY
    	--======================================================
    
    	while isProcedureValid(id) do
    
    		if shouldAbort(id) then
    			return
    		end
    
    		-- Mobs ALWAYS wins.
    		if contents:FindFirstChild("Mobs") then
    			return
    		end
    
    		loot =
    			contents:FindFirstChild("Loot")
    
    		if not loot then
    			return
    		end
    
    		local children =
    			loot:GetChildren()
    
    		-- Nothing left
    		if #children == 0 then
    			return
    		end
    
    		-- Process every current child
    		for _, lootItem in ipairs(children) do
    
    			if shouldAbort(id) then
    				return
    			end
    
    			-- If Mobs appears, instantly stop.
    			if contents:FindFirstChild("Mobs") then
    				return
    			end
    
    			-- The child may have disappeared already.
    			if not lootItem.Parent then
    				continue
    			end
    
    			local _, humanoid, root =
    				getCharacter()
    
    			if not humanoid or not root then
    				return
    			end
    
    			local lootPart = nil
    
    			if lootItem:IsA("BasePart") then
    
    				lootPart = lootItem
    
    			elseif lootItem:IsA("Model") then
    
    				lootPart =
    					lootItem.PrimaryPart
    					or lootItem:FindFirstChildWhichIsA(
    						"BasePart",
    						true
    					)
    			end
    
    			if lootPart then
    
    				-- Teleport to loot
    				root.CFrame =
    					lootPart.CFrame
    
    				-- Look at it
    				forceCameraLookAt(
    					lootPart
    				)
    
    				-- Find prompt anywhere inside
    				local prompt =
    					findPrompt(lootItem)
    
    				if prompt then
    					firePrompt(prompt)
    				end
    
    				-- Very small delay before next item
    				if not smartWait(
    					0.05,
    					id
    					) then
    					return
    				end
    			end
    		end
    	end
    end
    
    
    --========================================================
    -- PROCESS STORAGE
    --========================================================
    
    local function processStorage(storage, id)
    
    	if shouldAbort(id) then
    		return
    	end
    
    	local door =
    		storage:FindFirstChild("Door")
    
    	if not door then
    		return
    	end
    
    	local cube =
    		door:FindFirstChild("Cube.001")
    
    	local handle =
    		door:FindFirstChild("Handle")
    
    	if not cube
    		or not cube:IsA("BasePart") then
    
    		return
    	end
    
    	if not handle
    		or not handle:IsA("BasePart") then
    
    		return
    	end
    
    
    	--======================================================
    	-- TELEPORT TO STORAGE
    	--======================================================
    
    	local startingCFrame =
    		cube.CFrame
    		* CFrame.new(0, 0, 5)
    
    	if not teleportTo(startingCFrame) then
    		return
    	end
    
    
    	--======================================================
    	-- WAIT 2 SECONDS
    	--======================================================
    
    	if not smartWait(2, id) then
    		return
    	end
    
    
    	--======================================================
    	-- TWEEN TO HANDLE
    	--======================================================
    
    	local _, humanoid, root =
    		getCharacter()
    
    	if not humanoid or not root then
    		return
    	end
    
    	local tween =
    		TweenService:Create(
    			root,
    
    			TweenInfo.new(
    				1,
    				Enum.EasingStyle.Linear,
    				Enum.EasingDirection.InOut
    			),
    
    			{
    				CFrame = handle.CFrame
    			}
    		)
    
    	tween:Play()
    
    	while tween.PlaybackState ==
    		Enum.PlaybackState.Playing do
    
    		if shouldAbort(id) then
    
    			tween:Cancel()
    
    			return
    		end
    
    		task.wait(0.03)
    	end
    
    
    	if shouldAbort(id) then
    		return
    	end
    
    
    	--======================================================
    	-- LOOK AT HANDLE
    	--======================================================
    
    	forceCameraLookAt(handle)
    
    
    	--======================================================
    	-- OPEN STORAGE
    	--======================================================
    
    	local prompt =
    		findPrompt(handle)
    
    	if prompt then
    		firePrompt(prompt)
    	end
    
    
    	--======================================================
    	-- OPENING TIME
    	--
    	-- The 15-second timer starts NOW.
    	--======================================================
    
    	local openingStart =
    		os.clock()
    
    
    	--======================================================
    	-- CHECK MOBS AT 0.1 SECONDS
    	--======================================================
    
    	if not smartWait(
    		0.1,
    		id
    		) then
    		return
    	end
    
    	local contents =
    		storage:FindFirstChild("Contents")
    
    	if contents
    		and contents:FindFirstChild("Mobs") then
    
    		return
    	end
    
    
    	--======================================================
    	-- CHECK MOBS AGAIN AT 0.2 SECONDS
    	--======================================================
    
    	if not smartWait(
    		0.1,
    		id
    		) then
    		return
    	end
    
    	contents =
    		storage:FindFirstChild("Contents")
    
    	if contents
    		and contents:FindFirstChild("Mobs") then
    
    		return
    	end
    
    
    	--======================================================
    	-- LOOT CHECK
    	--======================================================
    
    	contents =
    		storage:FindFirstChild("Contents")
    
    	if contents then
    
    		local loot =
    			contents:FindFirstChild("Loot")
    
    		if loot then
    
    			-- Loot waits 0.2 sec before processing
    			processLoot(
    				storage,
    				id
    			)
    		end
    	end
    
    
    	--======================================================
    	-- 15 SECOND MAXIMUM
    	--======================================================
    
    	while isProcedureValid(id) do
    
    		if shouldAbort(id) then
    			return
    		end
    
    		if os.clock() - openingStart >= 15 then
    			return
    		end
    
    		-- Keep checking for Loot that might appear later.
    		contents =
    			storage:FindFirstChild("Contents")
    
    		if contents then
    
    			-- Mobs immediately wins
    			if contents:FindFirstChild("Mobs") then
    				return
    			end
    
    			local loot =
    				contents:FindFirstChild("Loot")
    
    			if loot then
    
    				processLoot(
    					storage,
    					id
    				)
    			end
    		end
    
    		task.wait(0.1)
    	end
    end
    
    
    --========================================================
    -- CLEANUP
    --========================================================
    
    local function cleanup()
    
    	local _, _, root =
    		getCharacter()
    
    	if root then
    		root.Anchored = false
    	end
    
    	healing = false
    
    	restoreCamera()
    
    	if originalCFrame then
    
    		local _, _, currentRoot =
    			getCharacter()
    
    		if currentRoot then
    			currentRoot.CFrame =
    				originalCFrame
    		end
    	end
    
    	if healthConnection then
    
    		healthConnection:Disconnect()
    
    		healthConnection = nil
    	end
    end
    
    
    --========================================================
    -- MAIN FARM LOOP
    --========================================================
    
    local function runProcedure(id)
    
    	local character, humanoid, root =
    		getCharacter()
    
    	if not character
    		or not humanoid
    		or not root then
    
    		return
    	end
    
    
    	-- Save starting position
    	originalCFrame =
    		root.CFrame
    
    
    	setupHealthMonitor(id)
    
    
    	while isProcedureValid(id) do
    
    		--==================================================
    		-- HEALTH
    		--==================================================
    
    		if humanoid.Health < 80
    			and not healing then
    
    			startHealing(id)
    		end
    
    
    		--==================================================
    		-- HEALING
    		--==================================================
    
    		if healing then
    
    			while
    				isProcedureValid(id)
    				and healing do
    
    				task.wait(0.05)
    			end
    
    			if not isProcedureValid(id) then
    				return
    			end
    		end
    
    
    		--==================================================
    		-- FIND RANDOM STORAGE
    		--==================================================
    
    		local storage =
    			getRandomValidStorage(id)
    
    		if not storage then
    
    			task.wait(0.1)
    
    			continue
    		end
    
    
    		--==================================================
    		-- PROCESS IT
    		--==================================================
    
    		processStorage(
    			storage,
    			id
    		)
    
    
    		if not isProcedureValid(id) then
    			return
    		end
    
    
    		-- Immediately find another storage
    		task.wait()
    	end
    end
    
    
    --========================================================
    -- TOGGLE
    --========================================================
    
    button.Activated:Connect(function()
    
    	active = not active
    
    
    	if active then
    		ind.BackgroundColor3 = green
    	else
    		ind.BackgroundColor3 = red
    	end
    
    
    	--======================================================
    	-- BUTTON BOUNCE
    	--======================================================
    
    	if currentTween then
    		currentTween:Cancel()
    	end
    
    	button.Size = originalSize
    
    	currentTween =
    		TweenService:Create(
    			button,
    			tweenInfoUp,
    			{
    				Size = biggerSize
    			}
    		)
    
    	currentTween:Play()
    
    	currentTween.Completed:Connect(function()
    
    		if not button.Parent then
    			return
    		end
    
    		currentTween =
    			TweenService:Create(
    				button,
    				tweenInfoDown,
    				{
    					Size = originalSize
    				}
    			)
    
    		currentTween:Play()
    	end)
    
    
    	--======================================================
    	-- ENABLE
    	--======================================================
    
    	if active then
    
    		procedureId += 1
    
    		local id =
    			procedureId
    
    		task.spawn(function()
    
    			runProcedure(id)
    
    		end)
    
    
    		--======================================================
    		-- DISABLE
    		--======================================================
    
    	else
    
    		procedureId += 1
    
    		cleanup()
    	end
    end)

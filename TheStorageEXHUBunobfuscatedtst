-- [Script Mimic]: StarterGui.EXXGUITheStorage.Main.Content.Items.ScrollingFrame.AutoBuyDropdown.Dropdowm.DropdownMenu.ScrollingFrame.Defense Blessing.highlight
task.spawn(function()
    local script = { Parent = obj_Defense_Blessing_3877, Name = "highlight" }
    local INTENSITY = 2 
    local FADE_SPEED = 15 
    local rs = game:GetService("RunService")
    local plrs = game:GetService("Players")
    local ui = script.Parent
    local p = plrs.LocalPlayer
    local pg = p:WaitForChild("PlayerGui")
    local m = p:GetMouse()
    local pct = math.clamp(INTENSITY / 10, 0, 1)
    local prg = 0 
    -- Track what the base properties are, and what WE last set them to
    local baseColor = ui.BackgroundColor3
    local baseTrans = ui.BackgroundTransparency
    local lastSetColor = ui.BackgroundColor3
    local lastSetTrans = ui.BackgroundTransparency
    rs.RenderStepped:Connect(function(dt)
    	if not ui.Visible then return end
    	local h = false
    	for _, o in ipairs(pg:GetGuiObjectsAtPosition(m.X, m.Y)) do
    		if o == ui or o:IsDescendantOf(ui) then
    			h = true
    			break
    		end
    	end
    	local wasIdle = (prg == 0)
    	prg = math.clamp(prg + (dt * FADE_SPEED * (h and 1 or -1)), 0, 1)
    	-- If completely idle, let Tweens run freely and keep our trackers updated
    	if wasIdle and prg == 0 then
    		baseColor = ui.BackgroundColor3
    		baseTrans = ui.BackgroundTransparency
    		lastSetColor = ui.BackgroundColor3
    		lastSetTrans = ui.BackgroundTransparency
    		return
    	end
    	-- 🚨 EXTERNAL CHANGE DETECTOR 🚨
    	-- If the property is different from what we set it to last frame, 
    	-- it means TweenService (or another script) changed it! 
    	-- We update our base target so we ride smoothly *on top* of the tween.
    	if math.abs(ui.BackgroundTransparency - lastSetTrans) > 0.001 then
    		baseTrans = ui.BackgroundTransparency
    	end
    	local cDiff = math.abs(ui.BackgroundColor3.R - lastSetColor.R) + math.abs(ui.BackgroundColor3.G - lastSetColor.G) + math.abs(ui.BackgroundColor3.B - lastSetColor.B)
    	if cDiff > 0.01 then
    		baseColor = ui.BackgroundColor3
    	end
    	-- Calculate hover targets based on the current base
    	local targetTrans = math.clamp(baseTrans - pct, 0, 1)
    	local targetColor = Color3.new(
    		math.clamp(baseColor.R + (1 - baseColor.R) * pct, 0, 1),
    		math.clamp(baseColor.G + (1 - baseColor.G) * pct, 0, 1),
    		math.clamp(baseColor.B + (1 - baseColor.B) * pct, 0, 1)
    	)
    	-- Apply the blended result
    	local newTrans = baseTrans + (targetTrans - baseTrans) * prg
    	local newColor = baseColor:Lerp(targetColor, prg)
    	ui.BackgroundTransparency = newTrans
    	ui.BackgroundColor3 = newColor
    	-- Record exactly what we set it to, so we can detect external changes next frame
    	lastSetTrans = newTrans
    	lastSetColor = newColor
    end)
end)


    	-- Restore all moved NPCs
    	for npc, originalCFrame in pairs(activeNPCsRevert) do
    		if npc and npc.Parent then
    			npc:PivotTo(originalCFrame)
    		end
    	end
    	table.clear(activeNPCsRevert)
    
    	-- Restore Player
    	local char = LocalPlayer.Character
    	local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    	if hrp and originalReturnCFrame then
    		hrp.AssemblyLinearVelocity = Vector3.zero
    		hrp.AssemblyAngularVelocity = Vector3.zero
    		char:PivotTo(originalReturnCFrame)
    		task.wait(0.1)
    		hrp.Anchored = false
    		originalReturnCFrame = nil
    		print("[AutoBuy] Player restored to original surface position.")
    	end
    
    	isProcessingQueue = false
    end
    
    local function doNpcTrip(npcName, info, hrp, char)
    	local theNPC = nil
    	local storages = workspace:FindFirstChild("Storages")
    	if storages then
    		for _, storage in ipairs(storages:GetChildren()) do
    			local npcContainer = storage:FindFirstChild("Contents") and storage.Contents:FindFirstChild("NPC")
    			if npcContainer and npcContainer:FindFirstChild(npcName) then
    				theNPC = npcContainer:FindFirstChild(npcName)
    				break
    			end
    		end
    	end
    
    	if not theNPC then return end
    
    	-- Move NPC and Player underground
    	local npcOrigin = theNPC:GetPivot()
    	activeNPCsRevert[theNPC] = npcOrigin -- Log for cleanup
    

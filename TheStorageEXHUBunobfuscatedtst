    local plrs = game:GetService("Players")
    local ui = script.Parent
    local p = plrs.LocalPlayer
    local pg = p:WaitForChild("PlayerGui")
    local m = p:GetMouse()
    
    local pct = math.clamp(INTENSITY / 10, 0, 1)
    
    local prg = 0 
    
    -- Track what the base properties are, and what WE last set them to
    local baseColor = ui.BackgroundColor3
    local baseTrans = ui.BackgroundTransparency
    

    	local h = false
    	local pos = ui.AbsolutePosition
    	local size = ui.AbsoluteSize
    
    	-- Pixel-perfect boundaries using PlayerMouse coordinates
    	if m.X >= pos.X and m.X <= (pos.X + size.X) and m.Y >= pos.Y and m.Y <= (pos.Y + size.Y) then
    		h = true
    	end
    
    	local wasIdle = (prg == 0)
    	prg = math.clamp(prg + (dt * FADE_SPEED * (h and 1 or -1)), 0, 1)
    

    	end
    
    	local autoBuy = parent:FindFirstChild("AutoBuyDropdown")
    	if not autoBuy then
    		logMessage("[Error] Missing 'AutoBuyDropdown'", red)
    		return nil
    	end
    
    	local dropdown = autoBuy:FindFirstChild("Dropdown")
    	if not dropdown then
    		logMessage("[Error] Missing 'Dropdown'", red)
    		return nil
    	end
    
    	local menu = dropdown:FindFirstChild("DropdownMenu")
    	if not menu then
    		logMessage("[Error] Missing 'DropdownMenu'", red)
    		return nil
    	end
    
    	local scrollingFrame = menu:FindFirstChild("ScrollingFrame")
    	if not scrollingFrame then
    		logMessage("[Error] Missing 'ScrollingFrame'", red)
    		return nil
    	end
    
    	return scrollingFrame
    end
    

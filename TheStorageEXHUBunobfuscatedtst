    -- ================= HELPER FUNCTIONS =================
    
    local function cleanText(str)
    	if not str then
    		return ""
    	end
    
    	return string.gsub(str, "<[^>]->", "")
    end
    
    local function ultraClick(button)
    	if not button or not button:IsA("GuiObject") then
    		return
    	end
    
    	local eventsToFire = {
    		"MouseButton1Click",
    		"MouseButton1Down",
    		"MouseButton1Up",
    		"Activated",
    		"InputBegan",
    		"InputEnded"
    	}
    
    	for _, eventName in ipairs(eventsToFire) do
    		pcall(function()
    			if getconnections then
    				for _, connection in ipairs(getconnections(button[eventName])) do
    					connection:Fire()
    				end
    			end
    		end)
    
    		pcall(function()
    			if firesignal then
    				firesignal(button[eventName])
    			end
    		end)
    	end
    
    	pcall(function()
    		local absPos = button.AbsolutePosition
    		local absSize = button.AbsoluteSize
    		local inset, _ = GuiService:GetGuiInset()
    
    		local centerX = absPos.X + (absSize.X / 2)
    		local rawCenterY = absPos.Y + (absSize.Y / 2)
    
    		local yTargets = {
    			rawCenterY,
    			rawCenterY + inset.Y,
    			rawCenterY - inset.Y
    		}
    
    		for _, y in ipairs(yTargets) do
    			VirtualInputManager:SendMouseButtonEvent(
    				centerX,
    				y,
    				0,
    				true,
    				game,
    				0
    			)
    
    			task.wait(0.01)
    
    			VirtualInputManager:SendMouseButtonEvent(
    				centerX,
    				y,
    				0,
    				false,
    				game,
    				0
    			)
    
    			task.wait(0.01)
    		end
    	end)
    end
    
    local function findDialogueButton(textToFind)
    	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    
    	if not playerGui then
    		return nil
    	end
    
    	local targetText = string.lower(textToFind)
    
    	for _, descendant in ipairs(playerGui:GetDescendants()) do
    		if descendant:IsA("TextButton")
    			or descendant:IsA("ImageButton")
    			or descendant:IsA("TextLabel") then
    
    			local textValue = ""
    
    			if descendant:IsA("TextLabel") then
    				textValue = cleanText(descendant.Text)
    			elseif descendant:IsA("TextButton") then
    				textValue = cleanText(descendant.Text)
    			end
    
    			if string.lower(descendant.Name) == targetText
    				or string.find(
    					string.lower(textValue),
    					targetText,
    					1,
    					true
    				) then
    
    				if descendant:IsA("TextLabel")
    					and descendant.Parent
    					and (
    						descendant.Parent:IsA("TextButton")
    							or descendant.Parent:IsA("ImageButton")
    					) then
    
    					return descendant.Parent
    				else
    					return descendant
    				end
    			end
    		end
    	end
    
    	return nil
    end
    
    local function getInventoryData(itemName)
    	local backpack = LocalPlayer:FindFirstChild("Backpack")
    	local character = LocalPlayer.Character
    	local totalCount = 0
    
    	local function scanContainer(container)
    		if not container then
    			return
    		end
    
    		for _, tool in ipairs(container:GetChildren()) do
    			if tool:IsA("Tool")
    				and (
    					tool.Name == itemName
    						or string.match(
    							tool.Name,
    							"^" .. itemName .. "%s+%d+$"
    						)
    				) then
    
    				totalCount += 1
    			end
    		end
    	end
    
    	scanContainer(backpack)
    	scanContainer(character)
    
    	return totalCount
    end
    
    -- =========================================================
    -- NPC DETECTION
    -- =========================================================
    
    local function getUnblacklistedNPC(npcNames)
    	local storages = workspace:FindFirstChild("Storages")
    
    	if not storages then
    		return nil
    	end
    
    	-- Check EVERY storage
    	for _, storage in ipairs(storages:GetChildren()) do
    
    		-- If Owner attribute exists at all, skip this storage
    		if storage:GetAttribute("Owner") ~= nil then
    			continue
    		end
    
    		-- Open must specifically be true
    		if storage:GetAttribute("Open") ~= true then
    			continue
    		end
    
    		-- Find Contents
    		local contents = storage:FindFirstChild("Contents")
    
    		if not contents then
    			continue
    		end
    
    		-- Find Contents.NPC
    		local npcFolder = contents:FindFirstChild("NPC")
    
    		if not npcFolder then
    			continue
    		end
    
    		-- Check EVERY child inside Contents.NPC
    		for _, npc in ipairs(npcFolder:GetChildren()) do
    
    			-- Check if this NPC is one we're currently looking for
    			if npcNames[npc.Name] then
    
    				-- Don't use an NPC instance we've already processed
    				if not blacklistedNPCs[npc] then
    					return npc
    				end
    			end
    		end
    	end
    
    	return nil
    end
    
    -- ================= CORE LOGIC =================
    
    local function cleanupAndRestore()
    	for npc, originalCFrame in pairs(activeNPCsRevert) do
    		if npc and npc.Parent then
    			npc:PivotTo(originalCFrame)
    		end
    	end
    
    	table.clear(activeNPCsRevert)
    
    	local char = LocalPlayer.Character
    	local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    	if hrp and originalReturnCFrame then
    		hrp.AssemblyLinearVelocity = Vector3.zero
    		hrp.AssemblyAngularVelocity = Vector3.zero
    
    		char:PivotTo(originalReturnCFrame)
    
    		task.wait(0.1)
    
    		hrp.Anchored = false
    		originalReturnCFrame = nil
    	end
    
    	isProcessingQueue = false
    end
    
    local function doNpcTrip(theNPC, info, hrp, char)
    	if not theNPC or not theNPC.Parent then
    		return
    	end
    
    	local npcOrigin = theNPC:GetPivot()
    	activeNPCsRevert[theNPC] = npcOrigin
    
    	local safeNpcPosition =
    		npcOrigin * CFrame.new(0, -4, 0)
    
    	local safePlayerPosition =
    		npcOrigin
    		* CFrame.new(0, -4, -4)
    		* CFrame.Angles(0, math.pi, 0)
    
    	hrp.Anchored = true
    	hrp.AssemblyLinearVelocity = Vector3.zero
    
    	char:PivotTo(safePlayerPosition)
    	theNPC:PivotTo(safeNpcPosition)
    
    	workspace.CurrentCamera.CFrame =
    		CFrame.lookAt(
    			workspace.CurrentCamera.CFrame.Position,
    			safeNpcPosition.Position
    		)
    
    	local prompt =
    		theNPC:FindFirstChildWhichIsA(
    			"ProximityPrompt",
    			true
    		)
    
    	if prompt then
    		if fireproximityprompt then
    			fireproximityprompt(prompt)
    		else
    			prompt:InputHoldBegin()
    			task.wait(prompt.HoldDuration or 0.1)
    			prompt:InputHoldEnd()
    		end
    	end
    
    	local b1 = nil
    
    	for i = 1, 30 do
    		if not active then
    			return
    		end
    
    		b1 = findDialogueButton(info.B1)
    
    		if b1 then
    			break
    		end
    
    		task.wait(0.1)
    	end
    
    	if b1 and active then
    		ultraClick(b1)
    	end
    
    	if info.B2 and active then
    		local b2 = nil
    
    		for i = 1, 30 do
    			if not active then
    				return
    			end
    
    			b2 = findDialogueButton(info.B2)
    
    			if b2 then
    				break
    			end
    
    			task.wait(0.1)
    		end
    
    		if b2 and active then
    			ultraClick(b2)
    		end
    	end
    
    	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    	local shopGui = nil
    
    	for i = 1, 15 do
    		if not active then
    			return
    		end
    
    		shopGui =
    			playerGui:FindFirstChild("ShopGui")
    			or playerGui:FindFirstChild("Shop")
    
    		if shopGui then
    			break
    		end
    
    		task.wait(0.1)
    	end
    
    	if shopGui and active then
    		for _, itemName in ipairs(info.Items) do
    			if not active then
    				return
    			end
    
    			local itemFrame = nil
    
    			for _, child in ipairs(shopGui:GetDescendants()) do
    				if child:IsA("Frame")
    					and child.Name == itemName then
    
    					itemFrame = child
    					break
    
    				elseif (
    					child:IsA("TextLabel")
    						or child:IsA("TextButton")
    					)
    						and cleanText(child.Text) == itemName then
    
    					local current = child
    
    					while current and current ~= shopGui do
    						if current:IsA("Frame") then
    							itemFrame = current
    							break
    						end
    
    						current = current.Parent
    					end
    
    					if itemFrame then
    						break
    					end
    				end
    			end
    
    			if itemFrame then
    				local buyButton =
    					itemFrame:FindFirstChild("Buy", true)
    					or itemFrame:FindFirstChild("Purchase", true)
    					or itemFrame:FindFirstChildWhichIsA("TextButton", true)
    					or itemFrame:FindFirstChildWhichIsA("ImageButton", true)
    
    				if buyButton then
    					local consecutiveFailures = 0
    
    					while active do
    						local preClickCount =
    							getInventoryData(itemName)
    
    						ultraClick(buyButton)
    
    						local successThisClick = false
    
    						for check = 1, 10 do
    							if not active then
    								return
    							end
    
    							task.wait(0.05)
    
    							if getInventoryData(itemName)
    								> preClickCount then
    
    								successThisClick = true
    								break
    							end
    						end
    
    						if successThisClick then
    							consecutiveFailures = 0
    						else
    							consecutiveFailures += 1
    
    							if consecutiveFailures >= 5 then
    								break
    							end
    						end
    
    						task.wait(0.1)
    					end
    				end
    			end
    		end
    	end
    
    	if activeNPCsRevert[theNPC] then
    		theNPC:PivotTo(activeNPCsRevert[theNPC])
    		activeNPCsRevert[theNPC] = nil
    	end
    
    	if shopGui then
    		shopGui.Parent = nil
    	end
    
    	-- Blacklist this specific NPC instance
    	blacklistedNPCs[theNPC] = true
    
    	-- Remove it from blacklist when it is destroyed
    	local destroyConnection
    
    	destroyConnection = theNPC.AncestryChanged:Connect(
    		function(_, newParent)
    			if not newParent then
    				blacklistedNPCs[theNPC] = nil
    
    				if destroyConnection then
    					destroyConnection:Disconnect()
    				end
    			end
    		end
    	)
    
    	task.wait(0.5)
    end
    
    local function startAutoBuyLoop()
    	task.spawn(function()
    		while active do
    			local itemsToBuy = {}
    
    			local dropdownFrame = getDropdownFrame()
    
    			if dropdownFrame then
    				for _, child in ipairs(dropdownFrame:GetChildren()) do
    					if child:IsA("TextButton")
    						and child:GetAttribute("Selected") == true then
    
    						table.insert(itemsToBuy, child.Name)
    					end
    				end
    			end
    
    			if #itemsToBuy > 0 then
    				local char =
    					LocalPlayer.Character
    					or LocalPlayer.CharacterAdded:Wait()
    
    				local hrp =
    					char:WaitForChild(
    						"HumanoidRootPart",
    						5
    					)
    
    				if hrp then
    					if not isProcessingQueue then
    						isProcessingQueue = true
    						originalReturnCFrame = hrp.CFrame
    					end
    
    					-- Build NPC queue
    					local npcQueue = {}
    
    					for _, itemName in ipairs(itemsToBuy) do
    						local data = NPC_CONFIG[itemName]
    
    						if data then
    							if not npcQueue[data.NPC] then
    								npcQueue[data.NPC] = {
    									Items = {},
    									B1 = data.B1,
    									B2 = data.B2
    								}
    							end
    
    							table.insert(
    								npcQueue[data.NPC].Items,
    								itemName
    							)
    						end
    					end
    
    					-- Keep scanning until there is an NPC to process.
    					while active and next(npcQueue) do
    						local npcNames = {}
    
    						for npcName in pairs(npcQueue) do
    							npcNames[npcName] = true
    						end
    
    						-- This scans every storage and every NPC
    						-- inside each valid storage.
    						local theNPC =
    							getUnblacklistedNPC(npcNames)
    
    						if theNPC then
    							local npcName = theNPC.Name
    							local info = npcQueue[npcName]
    
    							if info then
    								doNpcTrip(
    									theNPC,
    									info,
    									hrp,
    									char
    								)
    							end
    						else
    							-- No matching NPC right now.
    							-- Scan again very quickly.
    							task.wait(0.1)
    						end
    
    						-- Rebuild the queue from the current
    						-- dropdown selection so changes are picked up.
    						table.clear(npcQueue)
    
    						for _, itemName in ipairs(itemsToBuy) do
    							local data = NPC_CONFIG[itemName]
    
    							if data then
    								if not npcQueue[data.NPC] then
    									npcQueue[data.NPC] = {
    										Items = {},
    										B1 = data.B1,
    										B2 = data.B2
    									}
    								end
    
    								table.insert(
    									npcQueue[data.NPC].Items,
    									itemName
    								)
    							end
    						end
    					end
    				else
    					task.wait(0.1)
    				end
    			else
    				if isProcessingQueue then
    					cleanupAndRestore()
    				end
    
    				task.wait(0.1)
    			end
    		end
    
    		cleanupAndRestore()
    	end)
    end
    
    script.Parent.Activated:Connect(function()
    	active = not active
    
    	if ind then
    		ind.BackgroundColor3 =
    			active and green or red
    	end
    
    	if currentTween then
    		currentTween:Cancel()
    	end
    
    	script.Parent.Size = originalSize
    
    	currentTween = TweenService:Create(
    		script.Parent,
    		tweenInfoUp,
    		{
    			Size = biggerSize
    		}
    	)
    
    	currentTween:Play()
    
    	currentTween.Completed:Wait()
    
    	currentTween = TweenService:Create(
    		script.Parent,
    		tweenInfoDown,
    		{
    			Size = originalSize
    		}
    	)
    
    	currentTween:Play()
    
    	if active then
    		startAutoBuyLoop()
    	end
    end)
end)


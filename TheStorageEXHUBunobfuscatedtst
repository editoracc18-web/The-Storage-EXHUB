task.spawn(function() -- Script Context Connection Mode
    local script = { Parent = obj_FlySpeedSlider_7102, Name = "SliderScript" }
    local UserInputService = game:GetService("UserInputService")
    
    -- Reference your UI elements
    local container = script.Parent
    local sliderLine = container:WaitForChild("SliderLine")
    local knob = sliderLine:WaitForChild("SpeedSlider")
    local speedValueText = container:WaitForChild("Value")
    
    local dragging = false
    
    -- Define your custom range boundaries
    local MIN_VALUE = 0
    local MAX_VALUE = 100
    
    -- Function to update the slider's position and the text number
    local function updateSlider(input)
    	local lineX = sliderLine.AbsolutePosition.X
    	local lineWidth = sliderLine.AbsoluteSize.X
    	local mouseX = input.Position.X
    
    	-- Calculate percentage (math.clamp keeps it between 0 and 1)
    	local percentage = math.clamp((mouseX - lineX) / lineWidth, 0, 1)
    
    	-- Move the knob smoothly
    	knob.Position = UDim2.new(percentage, 0, 0.5, 0)
    
    	-- Convert percentage to a -300 to 300 number and update text
    	local finalValue = math.floor(MIN_VALUE + (percentage * (MAX_VALUE - MIN_VALUE)))
    	speedValueText.Text = tostring(finalValue)
    end
    
    -- Detect when the player clicks ANYWHERE on the main container frame
    container.InputBegan:Connect(function(input)
    	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
    		dragging = true
    		-- Instantly jump the slider to where the mouse just clicked
    		updateSlider(input)
    	end
    end)
    
    -- Detect when the player lets go of the mouse anywhere on the screen
    UserInputService.InputEnded:Connect(function(input)
    	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
    		dragging = false

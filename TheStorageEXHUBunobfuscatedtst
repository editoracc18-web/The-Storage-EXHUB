    	originalSize.Y.Scale, originalSize.Y.Offset + 6
    )
    local currentTween = nil
    
    -- Tables to keep track of modified parts and their original transparency
    local originalTransparencies = {} -- [BasePart] = originalTransparency
    local currentInRadius = {}        -- [BasePart] = true
    
    -- Clear and restore everything if deactivated
    local function clearAllTransparencies()
    	for part, origTrans in pairs(originalTransparencies) do
    		if part and part.Parent then
    			part.Transparency = origTrans
    		end
    	end
    	originalTransparencies = {}
    	currentInRadius = {}
    end
    

    		end
    
    		task.wait(0.1)
    	end
    end
    
    
    --========================================================
    -- CLEANUP
    --========================================================
    
    local function cleanup()
    
    	local _, _, root = getCharacter()
    
    	if root then
    		root.Anchored = false
    	end
    
    	healing = false
    
    	restoreCamera()
    
    	if originalCFrame then
    
    		local _, _, currentRoot = getCharacter()
    
    		if currentRoot then
    			currentRoot.CFrame = originalCFrame
    		end
    	end
    
    	if healthConnection then
    		healthConnection:Disconnect()
    		healthConnection = nil
    	end
    end
    
    
    --========================================================
    -- MAIN FARM LOOP
    --========================================================
    
    local function runProcedure(id)
    
    	local character, humanoid, root = getCharacter()
    
    	if not character or not humanoid or not root then return end
    
    	originalCFrame = root.CFrame
    
    	setupHealthMonitor(id)
    
    	while isProcedureValid(id) do
    
    		if humanoid.Health < 80 and not healing then
    			startHealing(id)
    		end
    
    		if healing then
    			while isProcedureValid(id) and healing do
    				task.wait(0.05)
    			end
    
    			if not isProcedureValid(id) then return end
    		end
    
    		local storage = getRandomValidStorage(id)
    
    		if not storage then
    			task.wait(0.1)
    			continue
    		end
    
    		processStorage(storage, id)
    
    		-- ==================================================
    		-- CAMERA FIX
    		-- Restores the camera to the player right after 
    		-- leaving/finishing/aborting the storage
    		-- ==================================================
    		restoreCamera()
    
    		if not isProcedureValid(id) then return end
    
    		-- Yield before scanning again
    		task.wait()
    	end
    end
    
    
    --========================================================
    -- TOGGLE
    --========================================================
    
    button.Activated:Connect(function()
    
    	active = not active
    
    	if active then
    		ind.BackgroundColor3 = green
    	else
    		ind.BackgroundColor3 = red
    	end
    
    	if currentTween then
    		currentTween:Cancel()
    	end
    
    	button.Size = originalSize
    
    	currentTween = TweenService:Create(
    		button,
    		tweenInfoUp,
    		{ Size = biggerSize }
    	)
    
    	currentTween:Play()
    
    	currentTween.Completed:Connect(function()
    
    		if not button.Parent then return end
    
    		currentTween = TweenService:Create(
    			button,
    			tweenInfoDown,
    			{ Size = originalSize }
    		)
    
    		currentTween:Play()
    	end)
    
    
    	if active then
    		procedureId += 1
    		local id = procedureId
    
    		task.spawn(function()
    			runProcedure(id)
    		end)
    	else
    		procedureId += 1
    		cleanup()
    	end
    end)
end)


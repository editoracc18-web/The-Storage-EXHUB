    	local dropdown = autoBuy and autoBuy:FindFirstChild("Dropdown")
    	local menu = dropdown and dropdown:FindFirstChild("DropdownMenu")
    	return menu and menu:FindFirstChild("ScrollingFrame")
    end
    
    -- ================= CONFIGURATION =================
    local NPC_CONFIG = {
    	["Pizza"] = {NPC = "Bartoli, Pizza Man", B1 = "Yes Please!", B2 = nil},

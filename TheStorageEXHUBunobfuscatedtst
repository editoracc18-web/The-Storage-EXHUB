    local script = { Parent = obj_Notifications_3258, Name = "Switcher" }
    local TweenService = game:GetService("TweenService")
    local btn = script.Parent
    local folder = btn.Parent
    local framesFolder = folder.Parent.Parent.Content
    local us = btn.Name
    -- Configure the tween (0.25 seconds duration)
    local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    btn.Activated:Connect(function()
    	if btn:GetAttribute("Active") then return end
    	-- Handle Buttons and Tweens
    	for _, i in ipairs(folder:GetChildren()) do
    		if i:IsA("GuiObject") then -- Ensure it's a UI element
    			if i == btn then
    				-- Activate and tween the clicked button
    				i:SetAttribute("Active", true)
    				TweenService:Create(i, tweenInfo, {BackgroundTransparency = 0.3}):Play()
    			else
    				-- Deactivate other buttons and tween them to 1 if needed
    				if i:GetAttribute("Active") then
    					i:SetAttribute("Active", false)
    				end
    				if i.BackgroundTransparency ~= 1 then
    					TweenService:Create(i, tweenInfo, {BackgroundTransparency = 1}):Play()
    				end
    			end
    		end
    	end
    	-- Handle Frames
    	for _, i in ipairs(framesFolder:GetChildren()) do
    		if i.Visible == true then
    			i.Visible = false
    		end
    	end
    	local targetFrame = framesFolder:FindFirstChild(us)
    	if targetFrame then
    		targetFrame.Visible = true
    	end
    end)
end)

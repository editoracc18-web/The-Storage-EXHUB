    	if not button or not button:IsA("GuiObject") then return end
    
    	local eventsToFire = {"MouseButton1Click", "MouseButton1Down", "MouseButton1Up", "Activated", "InputBegan", "InputEnded"}
    	for _, eventName in ipairs(eventsToFire) do
    		pcall(function()
    			if getconnections then
    				for _, connection in ipairs(getconnections(button[eventName])) do connection:Fire() end
    			end
    		end)
    		pcall(function()
    			if firesignal then firesignal(button[eventName]) end
    		end)
    	end
    
    	pcall(function()
    		local absPos = button.AbsolutePosition
    		local absSize = button.AbsoluteSize
    		local inset, _ = GuiService:GetGuiInset()
    
    		local centerX = absPos.X + (absSize.X / 2)
    		local rawCenterY = absPos.Y + (absSize.Y / 2)
    
    		local yTargets = { rawCenterY, rawCenterY + inset.Y, rawCenterY - inset.Y }
    
    		for _, y in ipairs(yTargets) do
    			VirtualInputManager:SendMouseButtonEvent(centerX, y, 0, true, game, 0)
    			task.wait(0.01)
    			VirtualInputManager:SendMouseButtonEvent(centerX, y, 0, false, game, 0)
    			task.wait(0.01)
    		end
    	end)
    end
    
    local function findDialogueButton(textToFind)
    	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    	if not playerGui then return nil end
    
    	local targetText = string.lower(textToFind)
    	for _, descendant in ipairs(playerGui:GetDescendants()) do
    		if descendant:IsA("TextButton") or descendant:IsA("ImageButton") or descendant:IsA("TextLabel") then
    			local textValue = descendant:IsA("TextLabel") and cleanText(descendant.Text) or (descendant:IsA("TextButton") and cleanText(descendant.Text) or "")
    
    			if string.lower(descendant.Name) == targetText or string.find(string.lower(textValue), targetText, 1, true) then
    				if descendant:IsA("TextLabel") and descendant.Parent and (descendant.Parent:IsA("TextButton") or descendant.Parent:IsA("ImageButton")) then
    					return descendant.Parent
    				else
    					return descendant
    				end
    			end
    		end
    	end
    	return nil
    end
    
    local function getInventoryData(itemName)
    	local backpack = LocalPlayer:FindFirstChild("Backpack")
    	local character = LocalPlayer.Character
    	local totalCount = 0
    
    	local function scanContainer(container)
    		if not container then return end
    		for _, tool in ipairs(container:GetChildren()) do
    			if tool:IsA("Tool") and (tool.Name == itemName or string.match(tool.Name, "^" .. itemName .. "%s+%d+$")) then
    				totalCount = totalCount + 1
    			end
    		end
    	end
    
    	scanContainer(backpack)
    	scanContainer(character)
    	return totalCount
    end
    

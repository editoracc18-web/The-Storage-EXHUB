    local box = bt.Parent.Parent.Parent.Items
    bt:SetAttribute("Selected", false)
    local cached = 0
    local name = ""
    bt.Activated:Connect(function()
    	cached = 0
    	name = ""
    	if bt:GetAttribute("Selected") then
    		bt:SetAttribute("Selected", false)
    		bt.BackgroundTransparency = 1
    		for _, i in ipairs(fol:GetChildren()) do
    			if i:IsA("TextButton") then
    				if i:GetAttribute("Selected") then
    					name = i.Name
    					if cached >= 2 then
    						box.Text = i.Name..", ..."
    					end

    	local safePlayerPosition = npcOrigin * CFrame.new(0, -4, -4) * CFrame.Angles(0, math.pi, 0)
    
    	hrp.Anchored = true 
    	hrp.AssemblyLinearVelocity = Vector3.zero
    	char:PivotTo(safePlayerPosition)
    	theNPC:PivotTo(safeNpcPosition)
    
    	-- Force Camera to look at NPC for proximity prompt
    	local camera = workspace.CurrentCamera
    	local originalCamType = camera.CameraType
    
    	camera.CameraType = Enum.CameraType.Scriptable
    	camera.CFrame = CFrame.lookAt(
    		safePlayerPosition.Position + (safePlayerPosition.LookVector * -3) + Vector3.new(0, 2, 0), 
    		safeNpcPosition.Position
    	)
    
    	task.wait(0.3) -- Give game a moment to render the UI on screen
    
    	local prompt = theNPC:FindFirstChildWhichIsA("ProximityPrompt", true)
    	if prompt then
    		logMessage("[Action] Firing ProximityPrompt...", green)
    		if fireproximityprompt then
    			fireproximityprompt(prompt)
    		else
    			prompt:InputHoldBegin()
    			task.wait((prompt.HoldDuration or 0.1) + 0.1)
    			prompt:InputHoldEnd()
    		end
    	else
    		logMessage("[Warn] No ProximityPrompt found on " .. theNPC.Name, red)
    	end
    
    	-- Restore Camera so player can see UI properly
    	camera.CameraType = originalCamType
    
    	local b1 = nil
    	for i = 1, 30 do
    		if not active then return false end
    		b1 = findDialogueButton(info.B1)
    		if b1 then break end
    		task.wait(0.1)
    	end
    
    	if b1 and active then 
    		logMessage("[Action] Clicking option: " .. info.B1, green)
    		ultraClick(b1) 
    	else
    		logMessage("[Error] Dialogue button 1 not found: " .. tostring(info.B1), red)
    	end
    
    	if info.B2 and active then
    		local b2 = nil
    		for i = 1, 30 do
    			if not active then return false end
    			b2 = findDialogueButton(info.B2)
    			if b2 then break end
    			task.wait(0.1)
    		end
    		if b2 and active then 
    			logMessage("[Action] Clicking option: " .. info.B2, green)
    			ultraClick(b2) 
    		else
    			logMessage("[Error] Dialogue button 2 not found: " .. tostring(info.B2), red)
    		end
    	end
    
    	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    	local shopGui = nil
    	for i = 1, 15 do
    		if not active then return false end
    		shopGui = playerGui:FindFirstChild("ShopGui") or playerGui:FindFirstChild("Shop")
    		if shopGui then break end
    		task.wait(0.1)
    	end
    
    	-- Check if Shop GUI failed to load and abort if it did
    	if not shopGui or not active then
    		logMessage("[Error] Shop Gui failed to open. Aborting Auto-Buy.", red)
    		active = false -- Disables the loop entirely
    		if ind then ind.BackgroundColor3 = red end -- Visually reset button indicator
    
    		-- Clean up the NPC locally before we bail
    		if activeNPCsRevert[theNPC] then
    			theNPC:PivotTo(activeNPCsRevert[theNPC])
    			activeNPCsRevert[theNPC] = nil
    		end
    
    		return false
    	end
    
    	logMessage("[Info] Shop GUI detected", green)
    	for _, itemName in ipairs(info.Items) do
    		if not active then return false end
    
    		local itemFrame = nil
    		for _, child in ipairs(shopGui:GetDescendants()) do
    			if child:IsA("Frame") and child.Name == itemName then
    				itemFrame = child
    				break
    			elseif (child:IsA("TextLabel") or child:IsA("TextButton")) and cleanText(child.Text) == itemName then
    				local current = child
    				while current and current ~= shopGui do
    					if current:IsA("Frame") then
    						itemFrame = current
    						break
    					end
    					current = current.Parent
    				end
    				if itemFrame then break end
    			end
    		end
    
    		if itemFrame then
    			local buyButton = itemFrame:FindFirstChild("Buy", true) 
    				or itemFrame:FindFirstChild("Purchase", true)
    				or itemFrame:FindFirstChildWhichIsA("TextButton", true)
    				or itemFrame:FindFirstChildWhichIsA("ImageButton", true)
    
    			if buyButton then
    				logMessage("[Action] Attempting to buy: " .. itemName, green)
    				local consecutiveFailures = 0
    				while active do
    					local preClickCount = getInventoryData(itemName)
    					ultraClick(buyButton)
    
    					local successThisClick = false
    					for check = 1, 10 do
    						if not active then return false end
    						task.wait(0.05) 
    						if getInventoryData(itemName) > preClickCount then
    							successThisClick = true
    							logMessage("[Success] Purchased " .. itemName, green)
    							break
    						end
    					end
    
    					if successThisClick then
    						consecutiveFailures = 0
    					else
    						consecutiveFailures += 1
    						if consecutiveFailures >= 5 then
    							logMessage("[Warn] Failed 5 buy attempts for " .. itemName, red)
    							break
    						end
    					end
    					task.wait(0.1)
    				end
    			else
    				logMessage("[Error] Buy button missing inside frame for " .. itemName, red)
    			end
    		else
    			logMessage("[Error] Could not find Shop frame for " .. itemName, red)
    		end
    	end
    
    	if activeNPCsRevert[theNPC] then
    		theNPC:PivotTo(activeNPCsRevert[theNPC])
    		activeNPCsRevert[theNPC] = nil
    	end
    
    	if shopGui then shopGui.Parent = nil end
    	blacklistedNPCs[theNPC] = true
    
    	local destroyConnection
    	destroyConnection = theNPC.AncestryChanged:Connect(function(_, newParent)
    		if not newParent then
    			blacklistedNPCs[theNPC] = nil
    			if destroyConnection then
    				destroyConnection:Disconnect()
    			end
    		end
    	end)
    
    	task.wait(0.5) 
    	return true
    end
    
    local function startAutoBuyLoop()
    	logMessage("[Info] Auto-Buy loop initialized", green)
    	task.spawn(function()
    		while active do
    			local itemsToBuy = {}
    			local dropdownFrame = getDropdownFrame()
    
    			if dropdownFrame then
    				for _, child in ipairs(dropdownFrame:GetChildren()) do
    					if child:IsA("TextButton") and child:GetAttribute("Selected") == true then
    						table.insert(itemsToBuy, child.Name)
    					end
    				end
    			end
    
    			if #itemsToBuy > 0 then
    				logMessage("[Info] Items queued: " .. table.concat(itemsToBuy, ", "), Color3.fromRGB(0, 200, 255))
    				local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    				local hrp = char:WaitForChild("HumanoidRootPart", 5)
    
    				if hrp then
    					if not isProcessingQueue then
    						isProcessingQueue = true
    						originalReturnCFrame = hrp.CFrame
    					end
    
    					local npcQueue = {}
    					for _, itemName in ipairs(itemsToBuy) do
    						local data = NPC_CONFIG[itemName]
    						if data then
    							if not npcQueue[data.NPC] then
    								npcQueue[data.NPC] = {Items = {}, B1 = data.B1, B2 = data.B2}
    							end
    							table.insert(npcQueue[data.NPC].Items, itemName)
    						else
    							logMessage("[Error] Item missing from NPC_CONFIG: " .. itemName, red)
    						end
    					end
    
    					for npcName, info in pairs(npcQueue) do
    						if not active then break end
    						local theNPC = getUnblacklistedNPC(npcName)
    						if theNPC then
    							local success = doNpcTrip(theNPC, info, hrp, char)
    							if not success then break end -- Break sequence if aborted
    						else
    							logMessage("[Warn] NPC not found or blacklisted: " .. npcName, red)
    						end
    					end
    				else
    					logMessage("[Error] HumanoidRootPart not found", red)
    				end
    			else
    				logMessage("[Info] No items marked as Selected in dropdown", Color3.fromRGB(255, 170, 0))
    				if isProcessingQueue then
    					cleanupAndRestore()
    				end
    			end
    
    			task.wait(3)
    		end
    
    		cleanupAndRestore()
    		logMessage("[Info] Auto-Buy deactivated", Color3.fromRGB(255, 170, 0))
    	end)
    end
    
    logMessage("[System] Script loaded and ready", Color3.fromRGB(0, 255, 255))
    
    -- Event Bindings
    local button = script.Parent
    local eventToConnect = button:IsA("GuiButton") and button.Activated or (button:IsA("ClickDetector") and button.MouseClick or nil)
    
    if not eventToConnect and button:IsA("Frame") then
    	logMessage("[Warning] Parent is a Frame, switching trigger to InputBegan", Color3.fromRGB(255, 170, 0))
    	eventToConnect = button.InputBegan
    end
    
    local function handleToggle(input)
    	if input and input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
    		return
    	end
    
    	active = not active
    	logMessage("Button Toggled! Active: " .. tostring(active), active and green or red)
    
    	if ind then
    		ind.BackgroundColor3 = active and green or red 
    	end
    
    	if currentTween then
    		currentTween:Cancel()
    	end
    
    	script.Parent.Size = originalSize
    	currentTween = TweenService:Create(script.Parent, tweenInfoUp, {Size = biggerSize})
    	currentTween:Play()
    
    	currentTween.Completed:Wait()
    
    	currentTween = TweenService:Create(script.Parent, tweenInfoDown, {Size = originalSize})
    	currentTween:Play()
    
    	if active then
    		startAutoBuyLoop()
    	end
    end
    
    if eventToConnect then
    	eventToConnect:Connect(handleToggle)
    else
    	logMessage("[Error] Script parent is not a clickable GUI element!", red)
    end
end)


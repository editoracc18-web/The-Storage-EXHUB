    	originalSize.Y.Offset + 6
    )
    
    local currentTween = nil
    
    
    --========================================================
    -- CHARACTER
    --========================================================
    
    local function getCharacter()
    	local character = player.Character
    
    	if not character then
    		return nil, nil, nil
    	end
    
    	local humanoid = character:FindFirstChildOfClass("Humanoid")
    	local root = character:FindFirstChild("HumanoidRootPart")
    
    	return character, humanoid, root
    end
    
    
    local function teleportTo(cframe)
    	local _, _, root = getCharacter()
    
    	if not root then
    		return false
    	end
    
    	root.CFrame = cframe
    
    	return true
    end
    
    
    local function isProcedureValid(id)
    	return active and procedureId == id
    end
    
    
    --========================================================
    -- CAMERA
    --========================================================
    
    local function forceCameraLookAt(part)
    
    	if cameraConnection then
    		cameraConnection:Disconnect()
    		cameraConnection = nil
    	end
    
    	if not part or not part.Parent then
    		return
    	end
    
    	local camera = workspace.CurrentCamera
    
    	camera.CameraType = Enum.CameraType.Scriptable
    
    	cameraConnection = RunService.RenderStepped:Connect(function()
    
    		if not active then
    			return
    		end
    
    		if not part or not part.Parent then
    			return
    		end
    
    		camera.CFrame = CFrame.lookAt(
    			camera.CFrame.Position,
    			part.Position
    		)
    	end)
    
    	camera.CFrame = CFrame.lookAt(
    		camera.CFrame.Position,
    		part.Position
    	)
    end
    
    
    local function restoreCamera()
    
    	if cameraConnection then
    		cameraConnection:Disconnect()
    		cameraConnection = nil
    	end
    
    	local camera = workspace.CurrentCamera
    
    	camera.CameraType = Enum.CameraType.Custom
    
    	local _, humanoid = getCharacter()
    
    	if humanoid then
    		camera.CameraSubject = humanoid
    	end
    end
    
    
    --========================================================
    -- HEALING
    --========================================================
    
    local function startHealing(id)
    
    	if healing then
    		return
    	end
    
    	healing = true
    
    	local _, humanoid, root = getCharacter()
    
    	if not humanoid or not root then
    		healing = false
    		return
    	end
    
    	restoreCamera()
    
    	-- Safe spot high in the sky to prevent mobs from reaching/attacking
    	local safeCFrame = CFrame.new(0, 50000, 0)
    
    	root.Anchored = true
    	root.CFrame = safeCFrame
    
    	task.spawn(function()
    		while active and procedureId == id and healing do
    
    			local _, currentHumanoid, currentRoot = getCharacter()
    
    			if not currentHumanoid or not currentRoot then
    				break
    			end
    
    			if currentHumanoid.Health >= 80 then
    				break
    			end
    
    			-- Ensure player stays in the safe spot
    			currentRoot.CFrame = safeCFrame
    
    			task.wait(0.1)
    		end
    
    		if not active or procedureId ~= id then
    			return
    		end
    
    		local _, _, currentRoot = getCharacter()
    
    		if currentRoot then
    			currentRoot.Anchored = false
    		end
    
    		healing = false
    	end)
    end
    
    
    --========================================================
    -- HEALTH
    --========================================================
    
    local function setupHealthMonitor(id)
    
    	if healthConnection then
    		healthConnection:Disconnect()
    		healthConnection = nil
    	end
    
    	local _, humanoid = getCharacter()
    
    	if not humanoid then
    		return
    	end
    
    	healthConnection =
    		humanoid.HealthChanged:Connect(function(health)
    
    			if not isProcedureValid(id) then
    				return
    			end
    
    			if health < 80 and not healing then
    				startHealing(id)
    			end
    		end)
    end
    
    
    local function shouldAbort(id)
    
    	if not isProcedureValid(id) then
    		return true
    	end
    
    	local _, humanoid = getCharacter()
    
    	if not humanoid then
    		return true
    	end
    
    	if humanoid.Health < 80 then
    
    		if not healing then
    			startHealing(id)
    		end
    
    		return true
    	end
    
    	return false
    end
    
    
    --========================================================
    -- WAIT
    --========================================================
    
    local function smartWait(seconds, id)
    
    	local elapsed = 0
    
    	while elapsed < seconds do
    
    		if shouldAbort(id) then
    			return false
    		end
    
    		task.wait(0.03)
    
    		elapsed += 0.03
    	end
    
    	return true
    end
    
    
    --========================================================
    -- NEARBY MOB CHECK
    --========================================================
    
    local function hasNearbyMob(storageModel)
    
    	local mobsFolder = workspace:FindFirstChild("Mobs")
    
    	if not mobsFolder then
    		return false
    	end
    
    	local storagePosition
    
    	if storageModel:IsA("Model") then
    		storagePosition = storageModel:GetPivot().Position
    	elseif storageModel:IsA("BasePart") then
    		storagePosition = storageModel.Position
    	else
    		return false
    	end
    
    	for _, mob in ipairs(mobsFolder:GetChildren()) do
    
    		if mob:IsA("Model") then
    
    			local mobRoot = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
    
    			if mobRoot then
    				if (mobRoot.Position - storagePosition).Magnitude <= 35 then
    					return true
    				end
    			end
    		end
    	end
    
    	return false
    end
    
    
    --========================================================
    -- STORAGE VALIDATION
    --========================================================
    
    local function isValidStorage(storage)
    
    	if not storage:IsA("Model") then
    		return false
    	end
    
    	if storage:GetAttribute("Owner") ~= nil then
    		return false
    	end
    
    	if storage:GetAttribute("Locked") ~= nil then
    		return false
    	end
    
    	if storage:GetAttribute("Open") == true then
    		return false
    	end
    
    	-- Dynamically filter out storages that have mobs inside
    	local contents = storage:FindFirstChild("Contents")
    	if contents and contents:FindFirstChild("Mobs") then
    		return false
    	end
    
    	if hasNearbyMob(storage) then
    		return false
    	end
    
    	return true
    end
    
    
    local function getRandomValidStorage(id)
    
    	local storages = workspace:FindFirstChild("Storages")
    
    	if not storages then
    		return nil
    	end
    
    	local valid = {}
    
    	for _, child in ipairs(storages:GetChildren()) do
    
    		if not isProcedureValid(id) then
    			return nil
    		end
    
    		if isValidStorage(child) then
    			table.insert(valid, child)
    		end
    	end
    
    	if #valid == 0 then
    		return nil
    	end
    
    	return valid[math.random(1, #valid)]
    end
    
    
    --========================================================
    -- PROXIMITY PROMPT
    --========================================================
    
    local function findPrompt(container)
    
    	if not container then
    		return nil
    	end
    
    	return container:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    
    
    local function firePrompt(prompt)
    
    	if not prompt then
    		return
    	end
    
    	if typeof(fireproximityprompt) == "function" then
    		fireproximityprompt(prompt)
    	end
    end
    
    
    --========================================================
    -- LOOT
    --========================================================
    
    local function processLoot(storage, id)
    
    	local contents = storage:FindFirstChild("Contents")
    	if not contents then return end
    
    	local loot = contents:FindFirstChild("Loot")
    	if not loot then return end
    
    	-- Quick wait to let items render
    	if not smartWait(0.1, id) then return end
    
    	-- Iterate through loot once (prevents infinite freezing)
    	for _, lootItem in ipairs(loot:GetChildren()) do
    
    		if shouldAbort(id) then return end
    
    		-- Mobs win instantly -> Skip storage
    		if contents:FindFirstChild("Mobs") then return end
    
    		if not lootItem.Parent then continue end
    
    		local _, humanoid, root = getCharacter()
    		if not humanoid or not root then return end
    
    		local lootPart = nil
    
    		if lootItem:IsA("BasePart") then
    			lootPart = lootItem
    		elseif lootItem:IsA("Model") then
    			lootPart = lootItem.PrimaryPart or lootItem:FindFirstChildWhichIsA("BasePart", true)
    		end
    
    		if lootPart then
    
    			root.CFrame = lootPart.CFrame
    			forceCameraLookAt(lootPart)
    
    			local prompt = findPrompt(lootItem)
    			if prompt then
    				firePrompt(prompt)
    
    				-- Wait for the item to be collected (max 1.5 seconds)
    				local timeout = os.clock() + 1.5
    				while lootItem.Parent and os.clock() < timeout do
    					if shouldAbort(id) or contents:FindFirstChild("Mobs") then return end
    					task.wait(0.05)
    				end
    			end
    		end
    	end
    end
    
    
    --========================================================
    -- PROCESS STORAGE
    --========================================================
    
    local function processStorage(storage, id)
    
    	if shouldAbort(id) then return end
    
    	local door = storage:FindFirstChild("Door")
    	if not door then return end
    
    	local cube = door:FindFirstChild("Cube.001")
    	local handle = door:FindFirstChild("Handle")
    
    	if not cube or not cube:IsA("BasePart") then return end
    	if not handle or not handle:IsA("BasePart") then return end
    
    	-- Teleport to storage
    	local startingCFrame = cube.CFrame * CFrame.new(0, 0, 3)
    
    	if not teleportTo(startingCFrame) then return end
    
    	-- Faster wait
    	if not smartWait(0.2, id) then return end
    
    	-- Faster Tween
    	local _, humanoid, root = getCharacter()
    	if not humanoid or not root then return end
    
    	local tween = TweenService:Create(
    		root,
    		TweenInfo.new(0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
    		{ CFrame = handle.CFrame }
    	)
    
    	tween:Play()
    
    	while tween.PlaybackState == Enum.PlaybackState.Playing do
    		if shouldAbort(id) then
    			tween:Cancel()

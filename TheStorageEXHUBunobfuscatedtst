task.spawn(function()
    local script = { Parent = obj_TopBar_8094, Name = "drag" }
    local UserInputService = game:GetService("UserInputService")
    -- Variables for the two UI objects
    local dragHandle = script.Parent        -- The object you click and hold
    local dragTarget = script.Parent.Parent -- The object that actually moves
    local dragging = false
    local dragInput
    local dragStart
    local startPos
    -- Function to update the target's position based on movement
    local function update(input)
    	local delta = input.Position - dragStart
    	dragTarget.Position = UDim2.new(
    		startPos.X.Scale, 
    		startPos.X.Offset + delta.X, 
    		startPos.Y.Scale, 
    		startPos.Y.Offset + delta.Y
    	)
    end
    -- Detect when user presses down on the drag handle
    dragHandle.InputBegan:Connect(function(input)
    	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
    		dragging = true
    		dragStart = input.Position
    		startPos = dragTarget.Position
    		-- Capture the input to track it even if the mouse leaves the handle area
    		input.Changed:Connect(function()
    			if input.UserInputState == Enum.UserInputState.End then
    				dragging = false
    			end
    		end)
    	end
    end)
    -- Detect when user moves their mouse/finger
    dragHandle.InputChanged:Connect(function(input)
    	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
    		dragInput = input
    	end
    end)
    -- Update the position on the screen
    UserInputService.InputChanged:Connect(function(input)
    	if input == dragInput and dragging then
    		update(input)
    	end
    end)
end)

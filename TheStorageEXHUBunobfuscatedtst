    local active = false
    local healing = false
    
    local procedureId = 0
    local originalCFrame = nil
    
    local cameraConnection = nil
    local healthConnection = nil
    
    --========================================================
    -- BUTTON ANIMATION
    --========================================================
    
    local originalSize = button.Size
    
    local tweenInfoUp = TweenInfo.new(

task.spawn(function() -- Deferred Script Context Connection Mode
    local script = { Parent = ui_instances.PToTPBaseToggle_7602, Name = "Function" }
    local TweenService = game:GetService("TweenService")
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService") -- Added UserInputService
    
    local ind = script.Parent.Indicator
    local red = Color3.fromRGB(255, 0, 0)
    local green = Color3.fromRGB(0, 255, 0)
    local active = false
    local player = Players.LocalPlayer
    
    local collisionParts = {}
    local originalSize = script.Parent.Size
    local tweenInfoUp = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tweenInfoDown = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    
    local biggerSize = UDim2.new(
    	originalSize.X.Scale, originalSize.X.Offset + 6,
    	originalSize.Y.Scale, originalSize.Y.Offset + 6
    )
    local currentTween = nil
    local loopConnection = nil
    
    -- Listen for keyboard inputs
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
    	if not gameProcessed and input.KeyCode == Enum.KeyCode.P then
    		if active then
    			local Players = game:GetService("Players")
    			local localPlayer = Players.LocalPlayer
    			local storagesFolder = workspace:WaitForChild("Storages")
    			for _, child in ipairs(storagesFolder:GetChildren()) do if child:GetAttribute("Owner") == localPlayer.Name then
    					localPlayer.Character:PivotTo(child:GetPivot())
    				end
    			end
    		end
    	end
    end)
    
    script.Parent.Activated:Connect(function()
    	active = not active
    
    	if active then
    		ind.BackgroundColor3 = green
    		table.clear(collisionParts)
    
    		local character = player.Character
    		if character then
    			for _, object in ipairs(character:GetDescendants()) do
    				if object:IsA("BasePart") and object.CanCollide then
    					table.insert(collisionParts, object)
    					object.CanCollide = false
    				end
    			end
    		end
    
    		-- Continuously force CanCollide to false while active
    		if loopConnection then loopConnection:Disconnect() end
    		loopConnection = RunService.Heartbeat:Connect(function()
    			local char = player.Character
    			if char then
    				for _, part in ipairs(collisionParts) do
    					if part and part.Parent then
    						part.CanCollide = false
    					end
    				end
    			end
    		end)
    
    	else
    		ind.BackgroundColor3 = red
    
    		-- Stop the continuous loop
    		if loopConnection then
    			loopConnection:Disconnect()
    			loopConnection = nil
    		end
    
    		-- Restore original collision state
    		for _, part in ipairs(collisionParts) do
    			if part and part.Parent then
    				part.CanCollide = true
    			end
    		end
    		table.clear(collisionParts)
    	end
    
    	if currentTween then
    		currentTween:Cancel()
    	end
    
    	script.Parent.Size = originalSize
    	currentTween = TweenService:Create(script.Parent, tweenInfoUp, { Size = biggerSize })
    	currentTween:Play()
    	currentTween.Completed:Wait()
    
    	currentTween = TweenService:Create(script.Parent, tweenInfoDown, { Size = originalSize })
    	currentTween:Play()
    end)
end)


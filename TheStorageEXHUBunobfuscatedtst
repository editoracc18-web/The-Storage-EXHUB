    local RunService = game:GetService("RunService")
    local Players = game:GetService("Players")
    
    local player = Players.LocalPlayer
    local ind = script.Parent:FindFirstChild("Indicator")
    local red = Color3.fromRGB(255, 0, 0)
    local green = Color3.fromRGB(0, 255, 0)
    local active = false
    
    -- Save the original size
    local originalSize = script.Parent.Size
    local tweenInfoUp = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tweenInfoDown = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    local biggerSize = UDim2.new(
    	originalSize.X.Scale, originalSize.X.Offset + 6,
    	originalSize.Y.Scale, originalSize.Y.Offset + 6
    )
    local currentTween = nil
    
    -- Tables to keep track of modified parts and their original transparency
    local originalTransparencies = {} -- [BasePart] = originalTransparency
    local currentInRadius = {}       -- [BasePart] = true
    
    -- Clear and restore everything if deactivated
    local function clearAllTransparencies()
    	for part, origTrans in pairs(originalTransparencies) do
    		if part and part.Parent then
    			part.Transparency = origTrans
    		end
    	end
    	originalTransparencies = {}
    	currentInRadius = {}
    end
    
    script.Parent.Activated:Connect(function()
    	-- Toggle state
    	active = not active
    	if active then
    		if ind then ind.BackgroundColor3 = green end
    	else
    		if ind then ind.BackgroundColor3 = red end
    		clearAllTransparencies()
    	end
    
    	-- Play bounce animation
    	if currentTween then
    		currentTween:Cancel()
    	end
    	script.Parent.Size = originalSize
    	currentTween = TweenService:Create(script.Parent, tweenInfoUp, {Size = biggerSize})
    	currentTween:Play()
    	currentTween.Completed:Wait()
    	currentTween = TweenService:Create(script.Parent, tweenInfoDown, {Size = originalSize})
    	currentTween:Play()
    end)
    
    -- Linear Interpolation helper function
    local function lerp(min, max, alpha)
    	return min + (max - min) * math.clamp(alpha, 0, 1)
    end
    
    -- Scan workspace parts on Heartbeat when active
    RunService.Heartbeat:Connect(function()
    	if not active then return end
    
    	local character = player.Character
    	if not character then return end
    	local rootPart = workspace.CurrentCamera
    	if not rootPart then return end
    
    	local pos = rootPart.CFrame.Position
    	local radius = 200
    	local newlyFound = {}
    
    	local overlapParams = OverlapParams.new()
    	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    	overlapParams.FilterDescendantsInstances = {character}
    
    	-- Fetch all parts inside the 200 stud radius boundary
    	local partsInRadius = workspace:GetPartBoundsInRadius(pos, radius, overlapParams)
    
    	for _, part in ipairs(partsInRadius) do
    		if part:IsA("BasePart") then
    			newlyFound[part] = true
    
    			-- If it's a completely new part entering range, remember its base setting
    			if not currentInRadius[part] then
    				originalTransparencies[part] = part.Transparency
    				currentInRadius[part] = true
    			end
    
    			-- Dynamic Distance Transparency math
    			local distance = (part.Position - pos).Magnitude
    			local alpha = distance / radius -- Returns a value between 0 (closest) and 1 (edge)
    
    			-- Scale transparency smoothly from 0.6 (close) up to 0.9 (far)
    			part.Transparency = lerp(0.6, 0.9, alpha)
    		end
    	end
    
    	-- Check parts that went out of range and clean up
    	for part, _ in pairs(currentInRadius) do
    		if not newlyFound[part] then
    			if part and part.Parent then
    				part.Transparency = originalTransparencies[part] or 0
    			end
    			originalTransparencies[part] = nil
    			currentInRadius[part] = nil
    		end
    	end
    end)
end)


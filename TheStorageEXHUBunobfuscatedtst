    			local size = element.AbsoluteSize
    			local hitElement = mouseLoc.X >= pos.X and mouseLoc.X <= (pos.X + size.X) and mouseLoc.Y >= pos.Y and mouseLoc.Y <= (pos.Y + size.Y)
    

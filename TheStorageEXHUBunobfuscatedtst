    		return true
    	end
    
    	local _, humanoid = getCharacter()
    
    	if not humanoid then
    		return true
    	end
    
    	if humanoid.Health < 80 then
    
    		if not healing then
    			startHealing(id)
    		end
    
    		return true
    	end
    
    	return false
    end
    
    
    --========================================================
    -- WAIT
